#!/usr/bin/env bash
# sapi — the pi coding agent, isolated in Docker, scoped to the directory you run it from.
# https://github.com/sapiensmalti/sapi
#
# One file. No dependencies beyond bash, docker and coreutils.
set -Eeuo pipefail

readonly SAPI_VERSION="0.6.1"
readonly SAPI_REPO="${SAPI_REPO:-sapiensmalti/sapi}"
SAPI_REF_CUSTOM=0; [[ -n "${SAPI_REF:-}" ]] && SAPI_REF_CUSTOM=1
readonly SAPI_REF_CUSTOM
readonly SAPI_REF="${SAPI_REF:-v0.6.1}"
readonly IMAGE_REPOSITORY="sapi"
readonly CONFIG_VOLUME="${SAPI_CONFIG_VOLUME:-sapi-config}"
readonly LABEL="sh.sapi"

# Egress sidecar (network = allowlist). Pinned by digest; the source tarball
# of the same tag is pinned by checksum for SAPI_EGRESS_BUILD=1. Both are
# produced by .github/workflows/egress-image.yml from egress/ in this repo.
readonly EGRESS_VERSION="0.1.2"
readonly EGRESS_UID="65532"
readonly EGRESS_IMAGE="${SAPI_EGRESS_IMAGE:-ghcr.io/sapiensmalti/sapi-egress@sha256:fca853b3474b951ba13280e1e14911986b5c99b4dde0505042be2a4886fcd8ef}"
readonly EGRESS_SOURCE_URL="https://github.com/sapiensmalti/sapi/releases/download/egress-v$EGRESS_VERSION/sapi-egress-src-$EGRESS_VERSION.tar.gz"
readonly EGRESS_SOURCE_SHA256="51c4d663122901978952a03b16fa7b209ebb819a1780292565f207abdc0da762"
readonly EGRESS_LOCAL_IMAGE="sapi-egress:$EGRESS_VERSION"

# ---------------------------------------------------------------------------
# Image definition. Embedded so that `sapi` is a single file.
# Print it with `sapi dockerfile`.
# ---------------------------------------------------------------------------
read -r -d '' DOCKERFILE <<'DOCKERFILE_EOF' || true
# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim

ARG PI_VERSION=latest

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TERM=xterm-256color \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates curl git jq less openssh-client procps ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*' \
    && mkdir -p /home/sapi /pi-config /pi-sessions

RUN npm install --global --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && npm cache clean --force \
    && pi --version

# uv gives the agent Python without touching the host. Two static binaries.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Entrypoint: optional self-update, then drop to the host user (Linux) so files
# written to /workspace are owned by you, not root. SAPI_CMD selects what
# runs after the drop (default pi; `sapi shell` uses bash).
COPY <<'ENTRYPOINT_EOF' /usr/local/bin/sapi-entrypoint
#!/bin/bash
set -eu
cmd="${SAPI_CMD:-pi}"
if [ "$cmd" = "pi" ] && [ "${SAPI_AUTO_UPDATE:-1}" = "1" ]; then
    pi update self --no-approve >&2 \
        || printf 'sapi: pi update failed; using installed pi %s\n' "$(pi --version 2>/dev/null)" >&2
fi
uid="${SAPI_UID:-0}"
gid="${SAPI_GID:-0}"
if [ "$uid" != "0" ]; then
    for dir in /pi-config /pi-sessions /pi-sessions-runs /home/sapi; do
        [ -d "$dir" ] || continue
        [ "$(stat -c '%u:%g' "$dir")" = "$uid:$gid" ] || chown -R "$uid:$gid" "$dir"
    done
    exec setpriv --reuid "$uid" --regid "$gid" --clear-groups \
        env HOME=/home/sapi USER=sapi "$cmd" "$@"
fi
exec "$cmd" "$@"
ENTRYPOINT_EOF
RUN chmod 0755 /usr/local/bin/sapi-entrypoint

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/sapi-entrypoint"]
DOCKERFILE_EOF
readonly DOCKERFILE

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
ERROR_STATUS=1
die() { printf 'sapi: %s\n' "$*" >&2; exit "$ERROR_STATUS"; }
log() { printf 'sapi: %s\n' "$*" >&2; }

# One exit hook for every transient resource; each is a no-op until set.
BACKUP_PARTIAL=""; BACKUP_TXN=""; BACKUP_LOCK=""; BACKUP_REAP=""; DIFF_TMP=""
RESTORE_TMP=""; RESTORE_TXN=""; RESTORE_DEST=""; RESTORE_COMMITTED=0
EGRESS_STOP_NAME=""; RUN_STOP_NAME=""; RUN_TIMER_PID=""; RUN_TMP=""
on_exit() {
    local rc=$?
    trap - EXIT ERR
    set +e
    [[ -n "$RUN_TIMER_PID" ]] && { kill "$RUN_TIMER_PID" 2>/dev/null; wait "$RUN_TIMER_PID" 2>/dev/null; }
    [[ -n "$RUN_STOP_NAME" ]] && docker rm --force "$RUN_STOP_NAME" >/dev/null 2>&1
    [[ -n "$EGRESS_STOP_NAME" ]] && docker rm --force "$EGRESS_STOP_NAME" >/dev/null 2>&1
    [[ -n "$BACKUP_PARTIAL" ]] && rm -f -- "$BACKUP_PARTIAL"
    [[ -n "$BACKUP_TXN" ]] && rm -rf -- "$BACKUP_TXN"
    [[ -n "$BACKUP_LOCK" ]] && { rm -f -- "$BACKUP_LOCK/pid"; rmdir -- "$BACKUP_LOCK" 2>/dev/null; }
    [[ -n "$BACKUP_REAP" ]] && rmdir -- "$BACKUP_REAP" 2>/dev/null
    [[ -n "$DIFF_TMP" ]] && rm -rf -- "$DIFF_TMP"
    if [[ -n "$RESTORE_TXN" && -n "$RESTORE_DEST" && "$RESTORE_COMMITTED" == 0 \
        && ( -e "$RESTORE_TXN/old" || -L "$RESTORE_TXN/old" ) ]]; then
        if [[ ! -e "$RESTORE_DEST" && ! -L "$RESTORE_DEST" ]] \
            && mv -- "$RESTORE_TXN/old" "$RESTORE_DEST" 2>/dev/null; then
            : # Original is back in place; the transaction can be discarded.
        else
            log "restore: rollback incomplete; original preserved at $RESTORE_TXN/old"
            RESTORE_TXN="" # Never delete the only saved original on a failed rollback.
        fi
    fi
    [[ -n "$RESTORE_TXN" ]] && rm -rf -- "$RESTORE_TXN"
    [[ -n "$RESTORE_TMP" ]] && rm -rf -- "$RESTORE_TMP"
    [[ -n "$RUN_TMP" ]] && rm -rf -- "$RUN_TMP"
    exit "$rc"
}
trap on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

usage() {
    cat <<EOF
sapi $SAPI_VERSION — the pi coding agent, isolated in Docker, scoped to this directory.

Usage:
  sapi [--safer|--no-safer] [NAME]
                     Start (or resume) an agent in the current directory
  sapi run [--json] [--timeout S] TASK
                     Headless: one task, final message on stdout, agent's exit code ('-' reads TASK from stdin)
  sapi backup        Back up this directory now (what --safer does before every start)
  sapi backups       List this directory's backups
  sapi diff [BACKUP] [--full]
                     What changed since the latest (or given) backup: A/M/D per path; --full for a unified diff
  sapi restore FILE|latest [DEST]
                     Restore a backup into DEST (default: a new sibling directory; never in place)
  sapi restore FILE|latest --files PATH...
                     Put back only the named paths, in place
  sapi config [show | set KEY VALUE | keys | path]
                     Show or change persistent settings
  sapi ls            List sapi containers
  sapi rm [--all]    Remove this directory's containers (or all of them)
  sapi shell [NAME] [--net]
                     A shell in /pi-sessions (session files) with /pi-config beside it; joins the running
                     agent, or starts an ephemeral container with the same volumes (no network unless --net)
  sapi netlog [NAME] Egress decisions (allow/deny, JSON lines) when network = allowlist
  sapi build         Build the image without starting a container
  sapi dockerfile    Print the embedded Dockerfile
  sapi upgrade       Upgrade sapi itself
  sapi version       Print version
  sapi help          Show this help

Environment:
  SAPI_MODEL          Model for pi --model (default: pi decides)
  SAPI_PI_VERSION     pi npm version to install in the image (default: latest)
  SAPI_AUTO_UPDATE=0  Do not run 'pi update' on container start
  SAPI_REBUILD=1      Rebuild the image from scratch
  SAPI_UID / SAPI_GID Container user (default: your uid/gid on Linux, root on macOS)
  SAPI_CONFIG_VOLUME  Docker volume for pi config and credentials (default: sapi-config)
  SAPI_ENV            Space-separated host variables to pass through, e.g. "ANTHROPIC_API_KEY GH_TOKEN"
  SAPI_DOCKER_ARGS    Extra arguments for 'docker create' (split on whitespace)
  SAPI_SAFER=1        Back up the directory before every start; abort if that fails
  SAPI_BACKUP_DIR     Where backups go (default: ~/.local/share/sapi/backups); must be outside the directory
  SAPI_BACKUP_KEEP    Backups to keep per directory (default: 10; 0 = keep all)

  SAPI_CPUS / SAPI_MEMORY_MIB / SAPI_PIDS
                      Resource ceilings for the agent container (default: unlimited / unlimited / 4096)
  SAPI_NETWORK        full (default) | allowlist — see 'sapi config keys' and docs/network.md
  SAPI_ALLOW          Allowed hosts/presets for allowlist mode (default: @providers)
  SAPI_EGRESS_BUILD=1 Build the egress sidecar from pinned source instead of pulling the image
  SAPI_PACKAGES       Extra Debian packages baked into the image, e.g. "golang make"
  SAPI_DOCKERFILE_EXTRA
                      Dockerfile fragment appended to the image (default: ~/.config/sapi/Dockerfile.extra)

Config file ($CONFIG_FILE), 'key = value' ('sapi config keys' lists them):
$(setting_help)
Precedence: flag > environment > config file > default.

Inside the agent:  detach with Ctrl-P, Ctrl-Q.  Reattach with 'sapi'.
Docs: https://github.com/$SAPI_REPO
EOF
}

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{print $1}'
    else die "need sha256sum or shasum"; fi
}

sanitize() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9_.-]+/-/g; s/^[-_.]+//; s/[-_.]+$//'
}

inspect() { docker container inspect --format "$2" "$1" 2>/dev/null || true; }
label()   { inspect "$1" "{{index .Config.Labels \"$LABEL.$2\"}}"; }

require_docker() {
    command -v docker >/dev/null 2>&1 || die "docker not found. See: https://github.com/$SAPI_REPO#install"
    if ! docker info >/dev/null 2>&1; then
        if [[ "$OS" == "Darwin" ]] && command -v open >/dev/null 2>&1; then
            log "Docker is not running; trying to start OrbStack or Docker Desktop ..."
            open -gj -a OrbStack >/dev/null 2>&1 || open -gj -a Docker >/dev/null 2>&1 || true
            for _ in $(seq 1 30); do docker info >/dev/null 2>&1 && break; sleep 1; done
        fi
    fi
    docker info >/dev/null 2>&1 || die "Docker is not running or you lack permission (on Linux: sudo usermod -aG docker \$USER, then re-login)."
}

# ---------------------------------------------------------------------------
# Context
# ---------------------------------------------------------------------------
OS="$(uname -s)"
WORKSPACE="$(pwd -P)"
WORKSPACE_HASH="$(printf '%s' "$WORKSPACE" | sha256)"
CONFIG_FILE="${SAPI_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/sapi/config}"
readonly CONFIG_FILE
PI_VERSION="${SAPI_PI_VERSION:-latest}"
MODEL="${SAPI_MODEL:-}"
REBUILD="${SAPI_REBUILD:-0}"
AUTO_UPDATE="${SAPI_AUTO_UPDATE:-1}"
if [[ "$OS" == "Linux" ]]; then
    UID_="${SAPI_UID:-$(id -u)}"; GID_="${SAPI_GID:-$(id -g)}"
else
    UID_="${SAPI_UID:-0}"; GID_="${SAPI_GID:-0}"
fi
readonly OS WORKSPACE WORKSPACE_HASH PI_VERSION MODEL REBUILD AUTO_UPDATE UID_ GID_

[[ "$REBUILD" == 0 || "$REBUILD" == 1 ]] || die "SAPI_REBUILD must be 0 or 1"
[[ "$AUTO_UPDATE" == 0 || "$AUTO_UPDATE" == 1 ]] || die "SAPI_AUTO_UPDATE must be 0 or 1"
[[ "$UID_$GID_" =~ ^[0-9]+$ ]] || die "SAPI_UID and SAPI_GID must be integers"

# The effective Dockerfile is the embedded one plus the user's toolchain
# customisation (see `packages` and `dockerfile_extra`). The image tag is a
# hash of everything that goes into it, so any change yields a new image and
# an unchanged definition is never rebuilt. Resolved after settings are read.
IMAGE=""; EFFECTIVE_DOCKERFILE=""
resolve_image() {
    [[ -n "$IMAGE" ]] && return 0
    EFFECTIVE_DOCKERFILE="$DOCKERFILE"
    if [[ -n "${SET_packages:-}" ]]; then
        EFFECTIVE_DOCKERFILE+="
# --- sapi: packages (from \`sapi config\` / SAPI_PACKAGES) ---
RUN apt-get update \\
    && apt-get install -y --no-install-recommends $SET_packages \\
    && rm -rf /var/lib/apt/lists/*"
    fi
    if [[ -n "${SET_dockerfile_extra:-}" && -f "$SET_dockerfile_extra" ]]; then
        [[ -r "$SET_dockerfile_extra" ]] || die "cannot read $SET_dockerfile_extra"
        EFFECTIVE_DOCKERFILE+="
# --- sapi: user Dockerfile.extra ---
$(cat "$SET_dockerfile_extra")"
    fi
    IMAGE="${SAPI_IMAGE:-$IMAGE_REPOSITORY:$(printf '%s\n%s\n' "$PI_VERSION" "$EFFECTIVE_DOCKERFILE" | sha256 | cut -c1-12)}"
}

# ---------------------------------------------------------------------------
# Config file
#
# Plain 'key = value' lines, '#' comments. Parsed with a whitelist and never
# sourced. An unknown key or an invalid value refuses to start: a safety
# setting that is silently ignored because of a typo is worse than none.
# ---------------------------------------------------------------------------
# Settings are declared once, here. Each has a type, an environment variable
# and a default; the same table drives parsing, precedence and `sapi config`.
readonly SETTING_KEYS="safer backup_dir backup_keep cpus memory_mib pids packages dockerfile_extra network allow"
setting_spec() {  # $1 key -> "type env default"
    case "$1" in
        safer)       printf 'bool SAPI_SAFER false' ;;
        backup_dir)  printf 'path SAPI_BACKUP_DIR %s' "${XDG_DATA_HOME:-$HOME/.local/share}/sapi/backups" ;;
        backup_keep) printf 'uint SAPI_BACKUP_KEEP 10' ;;
        cpus)        printf 'number SAPI_CPUS 0' ;;
        memory_mib)  printf 'uint SAPI_MEMORY_MIB 0' ;;
        pids)        printf 'uint SAPI_PIDS 4096' ;;
        packages)    printf 'packages SAPI_PACKAGES ' ;;
        dockerfile_extra) printf 'path SAPI_DOCKERFILE_EXTRA %s' "$(dirname "$CONFIG_FILE")/Dockerfile.extra" ;;
        network)     printf 'network SAPI_NETWORK full' ;;
        allow)       printf 'allow SAPI_ALLOW @providers' ;;
        *) return 1 ;;
    esac
}
setting_help() {
    cat <<'HELP'
  safer        bool    back up the directory before every start; abort if that fails
  backup_dir   path    where backups go (absolute; must be outside the directory)
  backup_keep  uint    backups kept per directory (0 = keep all)
  cpus         number  CPU ceiling for the agent container (0 = unlimited)
  memory_mib   uint    memory ceiling in MiB (0 = unlimited)
  pids         uint    process ceiling (0 = unlimited)
  packages     list    extra Debian packages baked into the image, e.g. "golang make postgresql-client"
  dockerfile_extra path  Dockerfile fragment appended to the image when the file exists
                       (default: ~/.config/sapi/Dockerfile.extra; user-level only, never from a project)
  network      enum    full (default) | allowlist — only hosts in 'allow' are reachable, on 80/443
  allow        list    hosts for network = allowlist: host, *.suffix, host:port, or presets
                       @providers @github @npm @pypi @cargo @go @debian @huggingface  (default: @providers)
HELP
}

# Keep the launcher's validation identical to the sidecar's DNS rules. In
# particular, an explicit port is useful only for 80/443: no other port is
# redirected by the firewall, so accepting :8443 would promise something that
# can never work.
validate_allow_entry() {
    local a="$1" host port labels label
    host="$a"
    if [[ "$host" == *:* ]]; then
        port="${host##*:}"; host="${host%:*}"
        [[ "$port" == 80 || "$port" == 443 ]] || return 1
    fi
    [[ "$host" == \*.* ]] && host="${host#\*.}"
    [[ -n "$host" && ${#host} -le 253 && "$host" != *..* && "$host" != .* && "$host" != *. ]] || return 1
    [[ "$host" =~ ^[A-Za-z0-9.-]+$ ]] || return 1
    local IFS='.'
    read -r -a labels <<< "$host"
    for label in ${labels[@]+"${labels[@]}"}; do
        [[ ${#label} -ge 1 && ${#label} -le 63 && "$label" != -* && "$label" != *- ]] || return 1
    done
}

# Validate a value for a key; print the normalised value or die.
validate_setting() {  # $1 key, $2 value, $3 where (for messages)
    local spec type; spec="$(setting_spec "$1")" || die "unknown setting '$1' (known: $SETTING_KEYS)"
    type="${spec%% *}"
    local v="$2" where="${3:-$1}"
    case "$type" in
        bool)
            case "$(printf '%s' "$v" | tr '[:upper:]' '[:lower:]')" in
                1|true|yes|on)  printf true ;;
                0|false|no|off) printf false ;;
                *) die "$where must be true or false, got '$v'" ;;
            esac ;;
        uint)   [[ "$v" =~ ^[0-9]+$ ]] || die "$where must be a non-negative integer, got '$v'"; printf '%s' "$v" ;;
        number) [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "$where must be a non-negative number, got '$v'"; printf '%s' "$v" ;;
        path)
            [[ "$v" == /* ]] || die "$where must be an absolute path, got '$v'"
            [[ "$v" != *$'\n'* && "$v" != *$'\r'* ]] || die "$where must not contain newlines"
            printf '%s' "$v" ;;
        network)
            case "$v" in
                full|allowlist) printf '%s' "$v" ;;
                *) die "$where must be full or allowlist, got '$v'" ;;
            esac ;;
        allow)
            local a out="" words
            words="${v//,/ }"; words="${words//$'\n'/ }"; words="${words//$'\r'/ }"
            local -a entries=()
            read -r -a entries <<< "$words"
            # Arrays, not unquoted expansion: '*.github.com' must never be
            # expanded against filenames in the invoking project.
            for a in ${entries[@]+"${entries[@]}"}; do
                if [[ "$a" == @* ]]; then
                    allow_preset "${a#@}" >/dev/null || die "$where: unknown preset '$a' (known: $(allow_presets))"
                else
                    validate_allow_entry "$a" || die "$where: '$a' is invalid (use a DNS name, *.suffix, optional :80/:443, or @preset)"
                fi
                out+="${out:+ }$a"
            done
            printf '%s' "$out" ;;
        packages)
            # Debian package names, whitespace or comma separated; normalised to one space.
            local p out="" words
            words="${v//,/ }"; words="${words//$'\n'/ }"; words="${words//$'\r'/ }"
            local -a entries=()
            read -r -a entries <<< "$words"
            for p in ${entries[@]+"${entries[@]}"}; do
                [[ "$p" =~ ^[a-z0-9][a-z0-9+.-]+$ ]] || die "$where: '$p' is not a valid Debian package name"
                out+="${out:+ }$p"
            done
            printf '%s' "$out" ;;
    esac
}

# Parse the config file into CFG_<key>. Whitelisted keys, validated values,
# never sourced. Unknown keys or invalid values refuse to start: a safety
# setting silently ignored because of a typo is worse than none.
load_config() {
    [[ -f "$CONFIG_FILE" ]] || return 0
    [[ -r "$CONFIG_FILE" ]] || die "cannot read $CONFIG_FILE"
    local line n=0 key value
    while IFS= read -r line || [[ -n "$line" ]]; do
        n=$((n + 1))
        line="$(printf '%s' "$line" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
        [[ -z "$line" || "$line" == \#* ]] && continue
        [[ "$line" =~ ^([a-z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]] \
            || die "$CONFIG_FILE:$n: expected 'key = value', got '$line'"
        key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
        value="$(validate_setting "$key" "$value" "$CONFIG_FILE:$n: $key")" || exit 1
        printf -v "CFG_$key" '%s' "$value"
    done <"$CONFIG_FILE"
}

# Effective settings into SET_<key> / SRC_<key>.
# Precedence: flag > environment > config file > default.
SAFER_FLAG=""   # set by --safer / --no-safer
SET_safer=""; SET_backup_dir=""; SET_backup_keep=""; SET_cpus=""; SET_memory_mib=""; SET_pids=""; SET_packages=""; SET_dockerfile_extra=""; SET_network=""; SET_allow=""

# ---------------------------------------------------------------------------
# Egress allowlist (network = allowlist)
#
# The agent container shares the network namespace of a sidecar that owns
# the namespace firewall and a transparent filter: every uid but the
# sidecar's own has DNS, 80 and 443 redirected to it and everything else
# dropped. The sidecar answers DNS itself (allowed names get a sink address,
# others NXDOMAIN), reads the TLS SNI or HTTP Host, checks the allowlist and
# connects by *name*. The agent holds no network capabilities and cannot
# change any of this. Source: egress/ in the sapi repository.
# ---------------------------------------------------------------------------
allow_presets() { printf '@providers @github @npm @pypi @cargo @go @debian @huggingface'; }
allow_preset() {  # $1 name -> hosts, or return 1
    case "$1" in
        providers)   printf 'api.anthropic.com api.openai.com openrouter.ai generativelanguage.googleapis.com api.mistral.ai api.groq.com api.x.ai api.deepseek.com api.together.xyz api.fireworks.ai api.cerebras.ai api.cohere.com api.perplexity.ai' ;;
        github)      printf 'github.com *.github.com *.githubusercontent.com codeload.github.com ghcr.io *.pkg.github.com' ;;
        npm)         printf 'registry.npmjs.org *.npmjs.org nodejs.org' ;;
        pypi)        printf 'pypi.org files.pythonhosted.org *.pypi.org' ;;
        cargo)       printf 'crates.io static.crates.io index.crates.io static.rust-lang.org' ;;
        go)          printf 'proxy.golang.org sum.golang.org' ;;
        debian)      printf 'deb.debian.org security.debian.org' ;;
        huggingface) printf 'huggingface.co *.huggingface.co cdn-lfs.huggingface.co' ;;
        *) return 1 ;;
    esac
}
# Expand presets into the concrete list handed to the sidecar.
expand_allow() {
    local a out="" words="${1//$'\n'/ }"
    local -a entries=()
    read -r -a entries <<< "$words"
    for a in ${entries[@]+"${entries[@]}"}; do
        if [[ "$a" == @* ]]; then out+="${out:+ }$(allow_preset "${a#@}")"; else out+="${out:+ }$a"; fi
    done
    printf '%s' "$out"
}
allow_includes_preset() { [[ " $SET_allow " == *" @$1 "* ]]; }

# Dockerfile that builds the sidecar from the pinned, checksummed source tarball.
read -r -d '' EGRESS_DOCKERFILE <<'EGRESS_DOCKERFILE_EOF' || true
# syntax=docker/dockerfile:1
FROM rust:1-alpine AS builder
ARG SRC_URL
ARG SRC_SHA256
RUN apk add --no-cache musl-dev curl
WORKDIR /src
RUN curl -fsSL --proto '=https' --tlsv1.2 "$SRC_URL" -o src.tar.gz \
    && echo "$SRC_SHA256  src.tar.gz" | sha256sum -c - \
    && tar -xzf src.tar.gz --strip-components=2 \
    && cargo build --release --locked \
    && cp target/release/sapi-egress /sapi-egress

FROM alpine:3.20
RUN apk add --no-cache iptables ip6tables \
    && addgroup -g 65532 -S egress && adduser -u 65532 -S -G egress -H -s /sbin/nologin egress \
    && mkdir -p /run/egress && chown 65532:65532 /run/egress
COPY --from=builder /sapi-egress /usr/local/bin/sapi-egress
ENTRYPOINT ["/usr/local/bin/sapi-egress"]
EGRESS_DOCKERFILE_EOF
readonly EGRESS_DOCKERFILE

# Make the sidecar image available; sets EGRESS_IMAGE_REF.
egress_image() {
    if [[ "${SAPI_EGRESS_BUILD:-0}" == 1 ]]; then
        EGRESS_IMAGE_REF="$EGRESS_LOCAL_IMAGE"
        if ! docker image inspect "$EGRESS_IMAGE_REF" >/dev/null 2>&1; then
            log "egress: building $EGRESS_IMAGE_REF from pinned source ($EGRESS_SOURCE_URL) ..."
            local ctx; ctx="$(mktemp -d)"
            printf '%s\n' "$EGRESS_DOCKERFILE" | DOCKER_BUILDKIT=1 docker build --tag "$EGRESS_IMAGE_REF" \
                --build-arg "SRC_URL=$EGRESS_SOURCE_URL" --build-arg "SRC_SHA256=$EGRESS_SOURCE_SHA256" -f - "$ctx" \
                || die "egress: source build failed"
            rmdir "$ctx"
        fi
    else
        EGRESS_IMAGE_REF="$EGRESS_IMAGE"
        if ! docker image inspect "$EGRESS_IMAGE_REF" >/dev/null 2>&1; then
            log "egress: pulling $EGRESS_IMAGE_REF ..."
            docker pull --quiet "$EGRESS_IMAGE_REF" >/dev/null || die "egress: cannot pull $EGRESS_IMAGE_REF (offline? set SAPI_EGRESS_BUILD=1 to build from source)"
        fi
    fi
}

# Create and start the sidecar for agent container $1; wait until its
# firewall is up. Dies, with the sidecar's log, if it does not come up.
egress_start() {  # $1 agent container name, $2 extra docker run flags (e.g. --rm)
    local agent="$1" extra="${2:-}" name="$1-egress"
    egress_image
    if docker container inspect "$name" >/dev/null 2>&1; then
        [[ "$(label "$name" managed)" == true && "$(label "$name" egress-of)" == "$agent" \
            && "$(label "$name" workspace-hash)" == "$WORKSPACE_HASH" ]] \
            || die "egress: $name already exists and is not this workspace's sidecar; refusing to remove it"
        docker container rm --force "$name" >/dev/null || die "egress: cannot replace $name"
    fi
    # shellcheck disable=SC2086
    docker run --detach $extra --name "$name" --init --read-only \
        --tmpfs "/run:rw,noexec,nosuid,nodev,size=1048576,mode=755" \
        --label "$LABEL.managed=true" --label "$LABEL.egress-of=$agent" --label "$LABEL.workspace-hash=$WORKSPACE_HASH" \
        --env "EGRESS_ALLOW=$(expand_allow "$SET_allow")" --env "EGRESS_UID=$EGRESS_UID" \
        --security-opt no-new-privileges --cap-drop ALL \
        --cap-add NET_ADMIN --cap-add SETUID --cap-add SETGID \
        --pids-limit 256 --memory 256m \
        "$EGRESS_IMAGE_REF" >/dev/null || die "egress: could not start sidecar"
    egress_wait "$name"
}

egress_wait() {
    local name="$1"
    for _ in $(seq 1 100); do
        if docker exec "$name" test -f /run/egress/ready 2>/dev/null; then
            return 0
        fi
        if [[ "$(inspect "$name" '{{.State.Running}}')" != true ]]; then break; fi
        sleep 0.1
    done
    docker logs "$name" 2>&1 | tail -n 20 >&2
    die "egress: sidecar $name did not become ready; the agent was not started"
}

cmd_netlog() {
    require_docker
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        name="$(docker container ls --all --filter "label=$LABEL.workspace-hash=$WORKSPACE_HASH" --filter "label=$LABEL.egress-of" --format '{{.Names}}' | head -n1)"
        [[ -n "$name" ]] || die "netlog: no egress sidecar for $WORKSPACE (network = allowlist not in use?)"
    else
        [[ "$name" == *-egress ]] || name="$name-egress"
    fi
    exec docker logs "$name"
}
resolve_settings() {
    load_config
    local key spec env default cfg_var env_val
    for key in $SETTING_KEYS; do
        spec="$(setting_spec "$key")"
        env="$(printf '%s' "$spec" | awk '{print $2}')"
        default="${spec#* * }"
        cfg_var="CFG_$key"
        env_val="${!env-}"
        if [[ "$key" == safer && -n "$SAFER_FLAG" ]]; then
            printf -v "SET_$key" '%s' "$SAFER_FLAG"; printf -v "SRC_$key" flag
        elif declare -p "$env" >/dev/null 2>&1; then
            # Set-but-empty is still an override. It is how a caller clears a
            # configured package/allow list; for scalar types validation fails.
            printf -v "SET_$key" '%s' "$(validate_setting "$key" "$env_val" "$env")" || exit 1
            printf -v "SRC_$key" environment
        elif [[ -n "${!cfg_var:-}" ]]; then
            printf -v "SET_$key" '%s' "${!cfg_var}"; printf -v "SRC_$key" config
        else
            printf -v "SET_$key" '%s' "$default"; printf -v "SRC_$key" default
        fi
    done
    SAFER="$SET_safer"; BACKUP_DIR="$SET_backup_dir"; BACKUP_KEEP="$SET_backup_keep"
}

cmd_config() {
    case "${1:-show}" in
        show)
            [[ $# -le 1 ]] || die "usage: sapi config [show]"
            resolve_settings
            printf 'config file  %s%s\n' "$CONFIG_FILE" "$([[ -f "$CONFIG_FILE" ]] || printf ' (absent)')"
            local key v s
            for key in $SETTING_KEYS; do
                v="SET_$key"; s="SRC_$key"
                printf '%-12s %s  (%s)\n' "$key" "${!v}" "${!s}"
            done ;;
        path) [[ $# -le 1 ]] || die "usage: sapi config path"; printf '%s\n' "$CONFIG_FILE" ;;
        keys) [[ $# -le 1 ]] || die "usage: sapi config keys"; setting_help ;;
        set)
            [[ $# -eq 3 ]] || die "usage: sapi config set KEY VALUE"
            local key="$2" value
            value="$(validate_setting "$key" "$3")" || exit 1
            load_config  # refuse to edit a file we cannot parse
            local dir tmp; dir="$(dirname "$CONFIG_FILE")"
            (umask 077 && mkdir -p "$dir") || die "cannot create $dir"
            tmp="$(umask 077 && mktemp "$dir/.config.XXXXXX")" || die "cannot write to $dir"
            if [[ -f "$CONFIG_FILE" ]] && grep -Eq "^[[:space:]]*${key}[[:space:]]*=" "$CONFIG_FILE"; then
                awk -v k="$key" -v v="$value" '
                    $0 ~ "^[[:space:]]*" k "[[:space:]]*=" && !done { print k " = " v; done = 1; next }
                    { print }' "$CONFIG_FILE" >"$tmp"
            else
                { [[ -f "$CONFIG_FILE" ]] && cat "$CONFIG_FILE"; printf '%s = %s\n' "$key" "$value"; } >"$tmp"
            fi
            mv -f "$tmp" "$CONFIG_FILE"
            log "$key = $value  ($CONFIG_FILE)" ;;
        *) die "usage: sapi config [show | set KEY VALUE | keys | path]" ;;
    esac
}

# ---------------------------------------------------------------------------
# Backups
#
# A backup is a tar.gz of the whole directory, taken from its parent, with
# symlinks preserved and nothing excluded, written outside the directory so
# the agent cannot reach it. It is written to a .partial file, verified by
# re-listing the archive, checksummed, then renamed into place: a half-written
# backup never looks like a finished one. Any failure aborts the launch.
# ---------------------------------------------------------------------------
backup_root() { printf '%s/%s-%s' "$BACKUP_DIR" "$(sanitize "$(basename "$WORKSPACE")")" "${WORKSPACE_HASH:0:8}"; }

backup_lock_acquire() { # mkdir is the portable atomic lock (no flock on macOS)
    local lock="$1/.backup.lock" reap="$1/.backup.reap" pid="" current=""
    if ! (umask 077 && mkdir "$lock") 2>/dev/null; then
        [[ -f "$lock/pid" ]] && pid="$(cat "$lock/pid")"
        # mkdir and PID publication are separate operations. Missing/invalid
        # ownership may mean a live creator; it is never proof of a stale lock.
        [[ "$pid" =~ ^[1-9][0-9]*$ ]] \
            || die "backup: incomplete lock $lock; retry, or inspect it if no backup is running"
        if kill -0 "$pid" 2>/dev/null; then
            die "backup: another backup for this directory is in progress (pid $pid)"
        fi
        # Serialize stale-owner recovery, then recheck ownership. Otherwise
        # two reapers can remove a new writer's lock using an old PID read.
        (umask 077 && mkdir "$reap") 2>/dev/null \
            || die "backup: lock recovery busy or interrupted; inspect $reap if no backup is running"
        BACKUP_REAP="$reap"
        [[ -f "$lock/pid" ]] && current="$(cat "$lock/pid")"
        [[ "$current" == "$pid" ]] || die "backup: lock owner changed; retry"
        kill -0 "$current" 2>/dev/null && die "backup: lock owner is still running (pid $current)"
        log "backup: removing stale lock $lock"
        rm -- "$lock/pid" && rmdir -- "$lock" || die "backup: cannot remove stale lock $lock"
        (umask 077 && mkdir "$lock") || die "backup: another writer acquired $lock; retry"
    fi
    BACKUP_LOCK="$lock"
    (umask 077 && printf '%s\n' "$$" >"$lock/pid") || die "backup: cannot write $lock/pid"
    if [[ -n "$BACKUP_REAP" ]]; then
        rmdir -- "$BACKUP_REAP" || die "backup: cannot release $BACKUP_REAP"
        BACKUP_REAP=""
    fi
}

backup_lock_release() {
    [[ -n "$BACKUP_LOCK" ]] || return 0
    rm -f -- "$BACKUP_LOCK/pid"
    rmdir -- "$BACKUP_LOCK" || die "backup: cannot release $BACKUP_LOCK"
    BACKUP_LOCK=""
}

backup_create() {
    command -v tar >/dev/null 2>&1 || die "backup: tar is required"
    [[ "$WORKSPACE" != "/" ]] || die "backup: refusing to back up /"
    local root; root="$(backup_root)"
    local inside="backup: $BACKUP_DIR is inside $WORKSPACE; a backup must live outside the directory it protects. Set SAPI_BACKUP_DIR elsewhere."
    # Check before creating anything, then again on the resolved path (symlinks).
    case "$BACKUP_DIR/" in "$WORKSPACE"/*) die "$inside" ;; esac
    (umask 077 && mkdir -p "$root") || die "backup: cannot create $root"
    local root_real; root_real="$(cd -- "$root" && pwd -P)"
    case "$root_real/" in
        "$WORKSPACE"/*) rmdir -p -- "$root" 2>/dev/null || true; die "$inside" ;;
    esac
    chmod 0700 "$root_real" || die "backup: cannot make $root_real private"
    backup_lock_acquire "$root_real"

    local need have
    need="$(du -sk -- "$WORKSPACE" 2>/dev/null | awk '{print $1}')" \
        && [[ "$need" =~ ^[0-9]+$ ]] || die "backup: cannot measure $WORKSPACE"
    have="$(df -Pk -- "$root_real" | awk 'NR == 2 {print $4}')" \
        && [[ "$have" =~ ^[0-9]+$ ]] || die "backup: cannot determine free space at $root_real"
    (( have > need + 65536 )) || die "backup: not enough space at $root_real (need ~$((need / 1024)) MiB, have $((have / 1024)) MiB)"

    local stamp name final partial
    # Names are UTC stamps and must sort chronologically, so a same-second
    # collision waits for the next second instead of adding a suffix.
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    while [[ -e "$root/$stamp.tar.gz" ]]; do sleep 1; stamp="$(date -u +%Y%m%dT%H%M%SZ)"; done
    name="$stamp.tar.gz"
    final="$root/$name"; partial="$root/.$name.partial"
    (umask 077 && mkdir "$partial") || die "backup: cannot create transaction $partial"
    BACKUP_TXN="$partial"

    log "backup: archiving $WORKSPACE (~$((need / 1024)) MiB) ..."
    local started rc=0
    started="$(date +%s)"
    (umask 077 && cd -- "$(dirname "$WORKSPACE")" && COPYFILE_DISABLE=1 tar -czf "$partial/archive" -- "$(basename "$WORKSPACE")") || rc=$?
    # GNU tar exits 1 when a file changed while being read: the archive is
    # complete but that file may be inconsistent. Anything worse is fatal.
    (( rc <= 1 )) || die "backup: tar failed (exit $rc); nothing was started"
    (( rc == 0 )) || log "backup: warning: some files changed while being archived"

    local entries sha bytes
    entries="$(tar -tzf "$partial/archive" | wc -l | tr -d ' ')" || die "backup: archive failed verification"
    (( entries > 0 )) || die "backup: archive is empty"
    sha="$(sha256 <"$partial/archive")"
    bytes="$(wc -c <"$partial/archive" | tr -d ' ')"
    (umask 077
     printf '%s  %s\n' "$sha" "$name" >"$partial/checksum"
     printf 'source = %s\ncreated_utc = %s\nsapi_version = %s\nhost = %s\nentries = %s\nbytes = %s\nsha256 = %s\ntar_exit = %s\nduration_s = %s\n' \
        "$WORKSPACE" "$stamp" "$SAPI_VERSION" "$(hostname 2>/dev/null || echo unknown)" "$entries" "$bytes" "$sha" "$rc" "$(( $(date +%s) - started ))" >"$partial/manifest") \
        || die "backup: cannot write metadata"
    # The archive is the commit point. A crash can leave orphan sidecars,
    # which the next backup removes, but never a visible archive whose
    # metadata has not been completely written.
    mv -f -- "$partial/checksum" "$final.sha256" || die "backup: cannot commit checksum"
    mv -f -- "$partial/manifest" "$final.manifest" || die "backup: cannot commit manifest"
    mv -- "$partial/archive" "$final" || die "backup: cannot commit archive"
    rmdir -- "$partial" || die "backup: cannot finish transaction"
    BACKUP_TXN=""
    BACKUP_PATH="$final"
    log "backup: $final ($((bytes / 1024 / 1024)) MiB, $entries entries, $(( $(date +%s) - started ))s)"
    backup_prune "$root"
    backup_lock_release
}

# Remove the oldest backups beyond BACKUP_KEEP. Only our own files, only in
# our own directory; names sort chronologically because they are UTC stamps.
backup_prune() {
    local root="$1" f count side archive
    # Clean metadata left by a power loss between sidecar and archive renames.
    find "$root" -maxdepth 1 -type f \( -name '*.tar.gz.sha256' -o -name '*.tar.gz.manifest' -o -name '*.tar.gz.run' \) | while IFS= read -r side; do
        archive="${side%%.tar.gz.*}.tar.gz"
        [[ -f "$archive" ]] || rm -f -- "$side"
    done
    (( BACKUP_KEEP > 0 )) || return 0
    count="$(find "$root" -maxdepth 1 -name '*.tar.gz' -type f | wc -l | tr -d ' ')"
    (( count > BACKUP_KEEP )) || return 0
    find "$root" -maxdepth 1 -name '*.tar.gz' -type f | sort | head -n $((count - BACKUP_KEEP)) | while IFS= read -r f; do
        rm -f -- "$f" "$f.sha256" "$f.manifest" "$f.run"
        log "backup: pruned $(basename "$f")"
    done
}

cmd_backup() { resolve_settings; backup_create; printf '%s\n' "$BACKUP_PATH"; }

cmd_backups() {
    resolve_settings
    local root f; root="$(backup_root)"
    [[ -d "$root" ]] || { log "no backups for $WORKSPACE"; return 0; }
    find "$root" -maxdepth 1 -name '*.tar.gz' -type f | sort | while IFS= read -r f; do
        printf '%s\t%s MiB\n' "$f" "$(( $(wc -c <"$f" | tr -d ' ') / 1024 / 1024 ))"
    done
}

# Validate the archive shape before extraction. sapi backups contain exactly
# one top-level directory; absolute and parent-traversing names are refused.
# A checksum proves integrity, not that an archive came from sapi: users
# should still restore only archives they trust.
archive_inspect() { # $1 archive, $2 listing output; sets ARCHIVE_TOP
    tar -tzf "$1" >"$2" 2>/dev/null || die "restore: $1 is not a readable tar.gz"
    local line first="" count=0
    while IFS= read -r line; do
        [[ -n "$line" ]] || die "restore: archive contains an empty member name"
        [[ "$line" != /* ]] || die "restore: archive contains an absolute path"
        case "/$line/" in *"/../"*) die "restore: archive contains parent traversal" ;; esac
        [[ -n "$first" ]] || first="$line"
        count=$((count + 1))
    done <"$2"
    (( count > 0 )) || die "restore: archive is empty"
    [[ "$first" == */ ]] || die "restore: expected a sapi backup with one top-level directory"
    ARCHIVE_TOP="${first%/}"
    [[ -n "$ARCHIVE_TOP" && "$ARCHIVE_TOP" != */* && "$ARCHIVE_TOP" != . && "$ARCHIVE_TOP" != .. ]] \
        || die "restore: invalid top-level directory"
    while IFS= read -r line; do
        [[ "$line" == "$ARCHIVE_TOP" || "$line" == "$ARCHIVE_TOP/" || "$line" == "$ARCHIVE_TOP/"* ]] \
            || die "restore: archive has more than one top-level entry"
    done <"$2"
}

# Copy one staged path into the workspace without following any symlink in
# its destination parents. The new item is complete before the old one is
# moved; on an error or caught signal, roll back or preserve the saved original.
restore_one() { # $1 staged source, $2 relative destination
    local src="$1" rel="$2" parent="$WORKSPACE" parent_rel="" part dest txn
    local -a parts=()
    [[ "$rel" == */* ]] && parent_rel="${rel%/*}"
    IFS='/' read -r -d '' -a parts < <(printf '%s\0' "$parent_rel")
    for part in ${parts[@]+"${parts[@]}"}; do
        [[ -z "$part" || "$part" == . ]] && continue
        parent="$parent/$part"
        [[ ! -L "$parent" ]] || die "restore: refusing to traverse symlink $parent"
        if [[ -e "$parent" ]]; then
            [[ -d "$parent" ]] || die "restore: $parent is not a directory"
        else
            mkdir -- "$parent" || die "restore: cannot create $parent"
        fi
    done
    dest="$WORKSPACE/$rel"
    txn="$(umask 077 && mktemp -d "$parent/.sapi-restore.XXXXXX")" || die "restore: cannot stage beside $dest"
    RESTORE_TXN="$txn"; RESTORE_DEST="$dest"; RESTORE_COMMITTED=0
    cp -Rp -- "$src" "$txn/item" || die "restore: could not stage $rel"
    if [[ -e "$dest" || -L "$dest" ]]; then
        mv -- "$dest" "$txn/old" || die "restore: could not set aside $dest"
    fi
    # Rollback belongs to the exit hook, including errors and caught signals.
    mv -- "$txn/item" "$dest" || die "restore: could not replace $dest"
    RESTORE_COMMITTED=1
    rm -rf -- "$txn"
    RESTORE_TXN=""; RESTORE_DEST=""
}

cmd_restore() {
    local file="${1:-}" dest="${2:-}"
    [[ -n "$file" ]] || die "usage: sapi restore FILE [DEST] | sapi restore FILE --files PATH..."
    [[ "$file" == latest ]] && { resolve_settings; file="$(latest_backup)" || die "restore: no backups for $WORKSPACE"; }
    [[ -f "$file" ]] || die "restore: no such file: $file"
    if [[ -f "$file.sha256" ]]; then
        local want have
        want="$(awk '{print $1}' "$file.sha256")"; have="$(sha256 <"$file")"
        [[ "$want" =~ ^[0-9a-f]{64}$ ]] || die "restore: invalid checksum sidecar for $file"
        [[ "$want" == "$have" ]] || die "restore: checksum mismatch for $file; refusing to restore a corrupt backup"
    else
        log "restore: warning: no checksum sidecar for $file; integrity is unverified"
    fi
    RESTORE_TMP="$(umask 077 && mktemp -d "${TMPDIR:-/tmp}/sapi-restore.XXXXXX")"
    case "$RESTORE_TMP/" in "$WORKSPACE"/*) die "restore: TMPDIR must be outside the workspace" ;; esac
    archive_inspect "$file" "$RESTORE_TMP/members"

    if [[ "$dest" == --files ]]; then
        [[ $# -ge 3 ]] || die "restore: --files needs at least one path"
        shift 2
        mkdir "$RESTORE_TMP/tree"
        tar -xzf "$file" -C "$RESTORE_TMP/tree" --strip-components=1 || die "restore: extraction failed"
        local p component restored=()
        for p in "$@"; do
            while [[ "$p" == ./* ]]; do p="${p#./}"; done
            while [[ "$p" == */ ]]; do p="${p%/}"; done
            [[ -n "$p" && "$p" != . && "$p" != /* ]] || die "restore: paths must name an item inside the directory"
            local -a components=()
            IFS='/' read -r -d '' -a components < <(printf '%s\0' "$p")
            for component in ${components[@]+"${components[@]}"}; do
                [[ "$component" != .. ]] || die "restore: paths must stay inside the directory: $p"
            done
            [[ -e "$RESTORE_TMP/tree/$p" || -L "$RESTORE_TMP/tree/$p" ]] || die "restore: '$p' is not in the backup"
            restore_one "$RESTORE_TMP/tree/$p" "$p"
            restored+=("$p")
        done
        for p in "${restored[@]}"; do printf 'restored  %s\n' "$p"; done
        return 0
    fi

    [[ $# -le 2 ]] || die "usage: sapi restore FILE [DEST] | sapi restore FILE --files PATH..."
    [[ -n "$dest" ]] || dest="$WORKSPACE.restored-$(date -u +%Y%m%dT%H%M%SZ)"
    local existed=0 parent txn
    if [[ -e "$dest" || -L "$dest" ]]; then
        [[ -d "$dest" && ! -L "$dest" ]] || die "restore: $dest exists and is not a real directory"
        [[ -z "$(ls -A -- "$dest")" ]] || die "restore: $dest is not empty; restores never overwrite"
        existed=1
    fi
    parent="$(dirname -- "$dest")"
    mkdir -p -- "$parent" || die "restore: cannot create $parent"
    txn="$(umask 077 && mktemp -d "$parent/.sapi-restore.XXXXXX")" || die "restore: cannot stage beside $dest"
    RESTORE_TXN="$txn"
    mkdir "$txn/tree"
    tar -xzf "$file" -C "$txn/tree" --strip-components=1 || die "restore: extraction failed"
    (( existed == 1 )) && rmdir -- "$dest"
    if ! mv -- "$txn/tree" "$dest"; then
        (( existed == 1 )) && mkdir -- "$dest" 2>/dev/null
        die "restore: could not move the completed tree into place"
    fi
    rm -rf -- "$txn"; RESTORE_TXN=""
    log "restored to $dest"
    printf '%s\n' "$dest"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_build() {
    resolve_settings; resolve_image; require_docker
    if [[ "$REBUILD" == 1 ]] || ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
        local opts=(--tag "$IMAGE" --build-arg "PI_VERSION=$PI_VERSION")
        [[ "$REBUILD" == 1 ]] && opts+=(--no-cache --pull)
        log "building $IMAGE ...${SET_packages:+ (packages: $SET_packages)}"
        local ctx; ctx="$(mktemp -d)"
        printf '%s\n' "$EFFECTIVE_DOCKERFILE" | DOCKER_BUILDKIT=1 docker build "${opts[@]}" -f - "$ctx"
        rmdir "$ctx"
    fi
}

cmd_dockerfile() { resolve_settings; resolve_image; printf '%s\n' "$EFFECTIVE_DOCKERFILE"; }

create_volume() { # $1 name, $2 role (config or sessions)
    docker volume create \
        --label "$LABEL.managed=true" --label "$LABEL.volume-role=$2" \
        --label "$LABEL.workspace=$WORKSPACE" --label "$LABEL.workspace-hash=$WORKSPACE_HASH" \
        "$1" >/dev/null || die "could not create Docker volume $1"
}

cmd_ls() {
    require_docker
    docker container ls --all --filter "label=$LABEL.managed=true" \
        --format 'table {{.Names}}\t{{.Status}}\t{{.Label "sh.sapi.workspace"}}'
}

cmd_rm() {
    require_docker
    local all=0
    [[ "${1:-}" == "--all" ]] && all=1
    local filter=("--filter" "label=$LABEL.managed=true")
    local vfilter=("--filter" "label=$LABEL.managed=true" "--filter" "label=$LABEL.volume-role=sessions")
    (( all == 1 )) || {
        filter+=("--filter" "label=$LABEL.workspace-hash=$WORKSPACE_HASH")
        vfilter+=("--filter" "label=$LABEL.workspace-hash=$WORKSPACE_HASH")
    }
    local names volumes="" n vol
    names="$(docker container ls --all "${filter[@]}" --format '{{.Names}}')"
    for n in $names; do
        vol="$(label "$n" sessions-volume)"
        [[ -n "$vol" ]] && volumes+="$vol"$'\n'
    done
    volumes+="$(docker volume ls "${vfilter[@]}" --format '{{.Name}}')"$'\n'
    if (( all == 0 )); then
        # Headless-run volumes created before volume labels were introduced.
        local ws base
        ws="$(sanitize "$(basename "$WORKSPACE")")"; ws="${ws:-workspace}"
        base="sapi-${ws:0:36}-${WORKSPACE_HASH:0:8}"
        docker volume inspect "$base-runs-sessions" >/dev/null 2>&1 && volumes+="$base-runs-sessions"$'\n'
    fi
    volumes="$(printf '%s' "$volumes" | awk 'NF && !seen[$0]++')"
    [[ -n "$names" || -n "$volumes" ]] || { log "nothing to remove"; return 0; }
    for n in $names; do
        docker container rm --force "$n" >/dev/null && log "removed container $n"
    done
    for vol in $volumes; do
        if docker volume rm "$vol" >/dev/null 2>&1; then log "removed volume $vol"
        else log "warning: could not remove volume $vol (still in use?)"; fi
    done
    log "kept config volume $CONFIG_VOLUME (credentials). Remove with: docker volume rm $CONFIG_VOLUME"
}

# ---------------------------------------------------------------------------
# sapi shell [NAME] [--net]: a shell where pi's files live
#
# Lands in /pi-sessions, the directory holding the session JSONL files. If an
# agent container for this directory is running, exec into it; otherwise
# start an ephemeral container with the same hardening and the same volumes
# (config, this directory's sessions, its headless-run sessions). Ephemeral
# shells have no network unless --net is given: a shell with the credentials
# volume mounted should not have egress by accident.
# ---------------------------------------------------------------------------
shell_banner() {
    printf '\n  /pi-config          pi settings, auth.json, extensions, gitconfig  (volume %s)\n' "$CONFIG_VOLUME" >&2
    printf '  /pi-sessions        session files (*.jsonl) of the interactive agent  (volume %s)\n' "$1" >&2
    [[ -n "${2:-}" ]] && printf '  /pi-sessions-runs   session files of `sapi run`  (volume %s)\n' "$2" >&2
    printf '  /workspace          %s\n\n' "$WORKSPACE" >&2
}

cmd_shell() {
    require_docker
    local name="" net=0 arg
    for arg in "$@"; do
        case "$arg" in
            --net) net=1 ;;
            -*) die "shell: unknown option $arg (options: --net)" ;;
            *) [[ -z "$name" ]] || die "shell: expected at most one NAME"; name="$arg" ;;
        esac
    done
    [[ -t 0 && -t 1 ]] || die "shell: an interactive terminal is required"

    local ws; ws="$(sanitize "$(basename "$WORKSPACE")")"; ws="${ws:-workspace}"
    local base="sapi-${ws:0:36}-${WORKSPACE_HASH:0:8}"
    local runs="$base-runs-sessions"
    if [[ -n "$name" ]]; then
        name="$(sanitize "$name")"; name="${name:0:54}"
        [[ -n "$name" ]] || die "shell: invalid container name"
    fi

    # A running agent for this directory (or the named one): join it. Inspect
    # by exact name: Docker's name filter is a regex, and dots are valid in
    # sapi container names.
    local running=""
    if [[ -n "$name" ]]; then
        if docker container inspect "$name" >/dev/null 2>&1; then
            [[ "$(label "$name" managed)" == true && "$(label "$name" workspace-hash)" == "$WORKSPACE_HASH" ]] \
                || die "shell: $name is not a sapi container for this directory"
            [[ "$(inspect "$name" '{{.State.Running}}')" == true ]] && running="$name"
        fi
    else
        running="$(docker container ls --filter "label=$LABEL.workspace-hash=$WORKSPACE_HASH" --filter "label=$LABEL.managed=true" --format '{{.Names}}' | grep -v -- '-egress$' | head -n1 || true)"
    fi
    if [[ -n "$running" ]]; then
        log "shell: joining running container $running"
        shell_banner "$(label "$running" sessions-volume)" ""
        exec docker exec --interactive --tty --user "$UID_:$GID_" --env HOME=/home/sapi --workdir /pi-sessions "$running" bash
    fi

    # Nothing running: an ephemeral container with the same spec and volumes.
    cmd_build
    # A shell is not an agent: no sidecar, no self-update, hostname set.
    SET_network=full; NETWORK_SIGNATURE=shell; AUTO_UPDATE_EFFECTIVE=0
    compute_settings_signature
    local sessions="${name:-$base}-sessions"
    docker volume inspect "$sessions" >/dev/null 2>&1 || log "shell: no sessions yet for ${name:-$WORKSPACE} (volume $sessions will be created)"
    create_volume "$CONFIG_VOLUME" config
    create_volume "$sessions" sessions
    local -a args=() extra=()
    local runs_mounted=""
    container_args "$base-shell-$$" "$sessions"
    args=("${CONTAINER_ARGS[@]}")
    if docker volume inspect "$runs" >/dev/null 2>&1; then
        extra+=(--mount "type=volume,source=$runs,target=/pi-sessions-runs"); runs_mounted="$runs"
    fi
    if (( net == 1 )); then log "shell: ephemeral container with network"; else extra+=(--network none); log "shell: ephemeral container, no network (--net to enable)"; fi
    shell_banner "$sessions" "$runs_mounted"
    exec docker run --rm --interactive --tty --label "$LABEL.shell=true" \
        "${args[@]}" ${extra[@]+"${extra[@]}"} \
        --env SAPI_CMD=bash --workdir /pi-sessions \
        "$IMAGE"
}

cmd_upgrade() {
    command -v curl >/dev/null 2>&1 || die "curl is required"
    local dir; dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
    if [[ "$SAPI_REF_CUSTOM" == 1 ]]; then
        local url="https://raw.githubusercontent.com/$SAPI_REPO/$SAPI_REF/install.sh"
        log "fetching $url"
        curl -fsSL "$url" | env SAPI_REF="$SAPI_REF" SAPI_INSTALL_DIR="$dir" bash
    else
        # The installed script is pinned to its own release; using that ref
        # here would pin upgrades to the past. The current installer selects
        # the newest release tag. SAPI_REF=main explicitly tracks development.
        local url="https://raw.githubusercontent.com/$SAPI_REPO/main/install.sh"
        log "fetching $url"
        curl -fsSL "$url" | SAPI_INSTALL_DIR="$dir" bash
    fi
}

# The container specification shared by `sapi` and `sapi run`: one place for
# mounts, environment, hardening and resource ceilings. Sets a global Bash
# array directly, so even whitespace in a path is never re-parsed.
container_args() {  # $1 container name, $2 sessions volume; sets CONTAINER_ARGS
    local name="$1" sessions="$2"
    local -a a=(--init --name "$name"
        --label "$LABEL.network=$NETWORK_SIGNATURE" --label "$LABEL.settings=$SETTINGS_SIGNATURE"
        --label "$LABEL.managed=true" --label "$LABEL.version=$SAPI_VERSION"
        --label "$LABEL.workspace=$WORKSPACE" --label "$LABEL.workspace-hash=$WORKSPACE_HASH"
        --label "$LABEL.model=$MODEL" --label "$LABEL.user=$UID_:$GID_" --label "$LABEL.auto-update=$AUTO_UPDATE"
        --volume "$WORKSPACE:/workspace"
        --mount "type=volume,source=$CONFIG_VOLUME,target=/pi-config"
        --mount "type=volume,source=$sessions,target=/pi-sessions"
        --workdir /workspace
        --env PI_CODING_AGENT_DIR=/pi-config --env PI_CODING_AGENT_SESSION_DIR=/pi-sessions
        --env GIT_CONFIG_GLOBAL=/pi-config/gitconfig
        --env "SAPI_AUTO_UPDATE=$AUTO_UPDATE_EFFECTIVE" --env "SAPI_UID=$UID_" --env "SAPI_GID=$GID_"
        --security-opt no-new-privileges --cap-drop ALL
        --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add DAC_READ_SEARCH --cap-add FOWNER
        --cap-add SETUID --cap-add SETGID)
    if [[ "$SET_network" == allowlist ]]; then
        # Share the sidecar's network namespace: its firewall is our firewall.
        a+=(--network "container:$name-egress")
    else
        a+=(--hostname sapi)
    fi
    # Resource ceilings (0 = unlimited).
    [[ "$SET_cpus" != 0 && "$SET_cpus" != 0.0 ]] && a+=(--cpus "$SET_cpus")
    [[ "$SET_memory_mib" != 0 ]] && a+=(--memory "${SET_memory_mib}m")
    [[ "$SET_pids" != 0 ]] && a+=(--pids-limit "$SET_pids")
    local var words
    local -a vars=()
    words="${SAPI_ENV:-}"; words="${words//$'\n'/ }"; words="${words//$'\r'/ }"
    read -r -a vars <<< "$words"
    for var in ${vars[@]+"${vars[@]}"}; do
        [[ "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "SAPI_ENV: invalid variable name '$var'"
        [[ -n "${!var:-}" ]] || log "warning: SAPI_ENV variable $var is unset"
        a+=(--env "$var")
    done
    if [[ -n "${SAPI_DOCKER_ARGS:-}" ]]; then
        local -a extra=()
        words="${SAPI_DOCKER_ARGS//$'\n'/ }"; words="${words//$'\r'/ }"
        read -r -a extra <<< "$words"
        a+=("${extra[@]}")
    fi
    CONTAINER_ARGS=("${a[@]}")
}

attach() {
    local name="$1"
    printf '\n  container  %s\n  workspace  %s\n  config     %s\n  sessions   %s\n  user       %s\n' \
        "$name" "$WORKSPACE" "$CONFIG_VOLUME" "$(label "$name" sessions-volume)" "$UID_:$GID_" >&2
    [[ -n "${BACKUP_PATH:-}" ]] && printf '  backup     %s\n' "$BACKUP_PATH" >&2
    printf '  detach     Ctrl-P, Ctrl-Q\n\n' >&2
    exec docker start --attach --interactive "$name"
}

# Everything the network mode implies, computed once per command.
compute_settings_signature() {
    # Everything Docker persists but the image itself. Secret *values* passed
    # through SAPI_ENV are deliberately not hashed into a public container
    # label; such containers are recreated instead of resumed (see cmd_start).
    SETTINGS_SIGNATURE="$(printf '%s\0' \
        "$NETWORK_SIGNATURE" "$MODEL" "$UID_:$GID_" "$AUTO_UPDATE_EFFECTIVE" \
        "$SET_cpus" "$SET_memory_mib" "$SET_pids" "$CONFIG_VOLUME" \
        "${SAPI_ENV:-}" "${SAPI_DOCKER_ARGS:-}" | sha256 | cut -c1-12)"
}

prepare_network() {
    NETWORK_SIGNATURE="$SET_network"
    AUTO_UPDATE_EFFECTIVE="$AUTO_UPDATE"
    if [[ "$SET_network" == allowlist ]]; then
        [[ "$UID_" != "$EGRESS_UID" ]] || die "network: agent uid $EGRESS_UID would inherit the sidecar's firewall exemption; set SAPI_UID to another uid"
        NETWORK_SIGNATURE="allowlist:$(printf '%s' "$(expand_allow "$SET_allow")" | sha256 | cut -c1-12)"
        if [[ "$AUTO_UPDATE" == 1 ]] && ! allow_includes_preset npm; then
            AUTO_UPDATE_EFFECTIVE=0
            log "network: allowlist without @npm; skipping pi self-update on start"
        fi
    fi
}

cmd_start() {
    [[ -t 0 && -t 1 ]] || die "an interactive terminal is required"
    resolve_settings
    prepare_network
    compute_settings_signature
    cmd_build
    # Snapshot the directory right before the agent gets access to it.
    BACKUP_PATH=""
    [[ "$SAFER" == true ]] && backup_create
    local image_id; image_id="$(docker image inspect --format '{{.Id}}' "$IMAGE")"

    local base
    if [[ -n "${1:-}" ]]; then base="$(sanitize "$1")"
    else
        local ws; ws="$(sanitize "$(basename "$WORKSPACE")")"; ws="${ws:-workspace}"
        base="sapi-${ws:0:36}-${WORKSPACE_HASH:0:8}"
    fi
    [[ -n "$base" ]] || die "invalid container name"
    base="${base:0:54}"

    create_volume "$CONFIG_VOLUME" config

    # Find a free slot: resume a compatible stopped container, replace an
    # incompatible one, or allocate a new slot if one is already running.
    local slot=1 name sessions
    while :; do
        name="$base"; [[ "$slot" -gt 1 ]] && name="$base-$slot"
        sessions="$name-sessions"
        docker container inspect "$name" >/dev/null 2>&1 || break
        if [[ "$(label "$name" managed)" != "true" || "$(label "$name" workspace-hash)" != "$WORKSPACE_HASH" ]]; then
            slot=$((slot + 1)); continue
        fi
        case "$(inspect "$name" '{{.State.Status}}')" in
            created | exited | dead)
                if [[ "$(inspect "$name" '{{.Image}}')" == "$image_id" \
                    && "$(label "$name" version)" == "$SAPI_VERSION" \
                    && "$(label "$name" model)" == "$MODEL" \
                    && "$(label "$name" user)" == "$UID_:$GID_" \
                    && "$(label "$name" auto-update)" == "$AUTO_UPDATE_EFFECTIVE" \
                    && "$(label "$name" network)" == "$NETWORK_SIGNATURE" \
                    && "$(label "$name" settings)" == "$SETTINGS_SIGNATURE" \
                    && -z "${SAPI_ENV:-}" ]]; then
                    if [[ "$SET_network" == allowlist ]]; then
                        # The firewall must be up before the agent's namespace comes back.
                        if docker container inspect "$name-egress" >/dev/null 2>&1; then
                            docker start "$name-egress" >/dev/null || die "egress: cannot start sidecar $name-egress"
                            egress_wait "$name-egress"
                        else
                            log "refreshing $name (its egress sidecar is gone)"
                            docker container rm --force "$name" >/dev/null
                            break
                        fi
                    fi
                    log "resuming $name"
                    attach "$name"
                fi
                log "refreshing $name (image or settings changed; sessions are kept)"
                docker container rm --force "$name" >/dev/null
                break ;;
            *) slot=$((slot + 1)); continue ;;
        esac
    done

    create_volume "$sessions" sessions

    local pi_args=(--continue)
    [[ -n "$MODEL" ]] && pi_args+=(--model "$MODEL")
    local -a args=()
    container_args "$name" "$sessions"
    args=("${CONTAINER_ARGS[@]}")

    if [[ "$SET_network" == allowlist ]]; then
        egress_start "$name"
        EGRESS_STOP_NAME="$name-egress" # removed if creation below fails
    fi
    docker create --interactive --tty \
        --label "$LABEL.sessions-volume=$sessions" \
        "${args[@]}" \
        "$IMAGE" "${pi_args[@]}" >/dev/null \
        || die "could not create container $name"
    EGRESS_STOP_NAME="" # a successfully created agent keeps its sidecar

    attach "$name"
}

# ---------------------------------------------------------------------------
# Headless: sapi run TASK
#
# One ephemeral container, one task, the agent's final message on stdout,
# the agent's exit code. Progress and diagnostics on stderr. With safer mode
# the run is bracketed by a backup before and a run manifest after, so a cron
# job leaves behind: what it was asked, what the tree looked like before, what
# it answered, how it exited, and (via `sapi diff`) exactly what it changed.
# ---------------------------------------------------------------------------
cmd_run() {
    local json=0 timeout=0 task_parts=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json=1; shift ;;
            --timeout) [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--timeout needs seconds"; timeout="$2"; shift 2 ;;
            --timeout=*) timeout="${1#*=}"; [[ "$timeout" =~ ^[0-9]+$ ]] || die "--timeout needs seconds"; shift ;;
            --) shift; task_parts+=("$@"); break ;;
            -) task_parts+=("$(cat)"); shift ;;
            -*) die "run: unknown option $1 (options: --json, --timeout SECONDS)" ;;
            *) task_parts+=("$1"); shift ;;
        esac
    done
    local task="${task_parts[*]:-}"
    [[ -n "${task//[[:space:]]/}" ]] || die "usage: sapi run [--json] [--timeout SECONDS] TASK  (or '-' to read TASK from stdin)"

    resolve_settings
    prepare_network
    cmd_build
    BACKUP_PATH=""
    [[ "$SAFER" == true ]] && backup_create

    local ws; ws="$(sanitize "$(basename "$WORKSPACE")")"; ws="${ws:-workspace}"
    local base="sapi-${ws:0:36}-${WORKSPACE_HASH:0:8}"
    local sessions="$base-runs-sessions"
    local name; name="$base-run-$(date -u +%Y%m%dT%H%M%SZ)-$$"
    create_volume "$CONFIG_VOLUME" config
    create_volume "$sessions" sessions

    compute_settings_signature
    local pi_args=(-p --no-approve)
    [[ "$json" == 1 ]] && pi_args+=(--mode json)
    [[ -n "$MODEL" ]] && pi_args+=(--model "$MODEL")
    pi_args+=(--name "sapi run $(date -u +%Y-%m-%dT%H:%M:%SZ)" -- "$task")

    local -a args=()
    container_args "$name" "$sessions"
    args=("${CONTAINER_ARGS[@]}")

    local started rc=0
    started="$(date +%s)"
    log "run: $name"
    if [[ "$SET_network" == allowlist ]]; then
        egress_start "$name" --rm
        EGRESS_STOP_NAME="$name-egress"
    fi
    # docker run in the background so a timeout can stop it cleanly; stdout
    # flows straight through to ours.
    RUN_STOP_NAME="$name" # signals and failures must never orphan the agent
    docker run --rm --label "$LABEL.run=true" "${args[@]}" "$IMAGE" "${pi_args[@]}" &
    local dpid=$!
    if (( timeout > 0 )); then
        RUN_TMP="$(umask 077 && mktemp -d "${TMPDIR:-/tmp}/sapi-run.XXXXXX")"
        (
            sleep "$timeout"
            : >"$RUN_TMP/expired"
            docker stop --time 10 "$name" >/dev/null 2>&1
        ) &
        RUN_TIMER_PID=$!
        wait "$dpid" || rc=$?
        if [[ -f "$RUN_TMP/expired" ]]; then
            rc=124
            log "run: timed out after ${timeout}s"
        fi
        kill "$RUN_TIMER_PID" 2>/dev/null || true
        wait "$RUN_TIMER_PID" 2>/dev/null || true
        RUN_TIMER_PID=""
        rm -rf -- "$RUN_TMP"; RUN_TMP=""
    else
        wait "$dpid" || rc=$?
    fi
    RUN_STOP_NAME=""

    if [[ -n "$BACKUP_PATH" ]]; then
        BACKUP_PARTIAL="$BACKUP_PATH.run.partial.$$"
        (umask 077; printf 'task = %s\ncontainer = %s\nstarted_utc = %s\nfinished_utc = %s\nexit_code = %s\nmodel = %s\nsapi_version = %s\n' \
            "$(printf '%s' "$task" | head -c 2000 | tr '\n' ' ')" "$name" "$(date -u -r "$started" +%Y%m%dT%H%M%SZ 2>/dev/null || date -u -d "@$started" +%Y%m%dT%H%M%SZ)" \
            "$(date -u +%Y%m%dT%H%M%SZ)" "$rc" "${MODEL:-default}" "$SAPI_VERSION" >"$BACKUP_PARTIAL") \
            && mv -f -- "$BACKUP_PARTIAL" "$BACKUP_PATH.run" || die "run: could not write $BACKUP_PATH.run"
        BACKUP_PARTIAL=""
        log "run: exit $rc · backup $BACKUP_PATH · see 'sapi diff' for changes"
    else
        log "run: exit $rc"
    fi
    return "$rc"
}

# ---------------------------------------------------------------------------
# sapi diff [BACKUP] [--full]: what changed since the backup
# ---------------------------------------------------------------------------
latest_backup() {
    local root; root="$(backup_root)"
    [[ -d "$root" ]] || return 1
    find "$root" -maxdepth 1 -name '*.tar.gz' -type f | sort | tail -n 1
}

# Manifest-based diff: recursive diff follows symlinks on some platforms and
# misses link-only/mode-only changes. Paths are compared as opaque bytes;
# base64 is used only to carry them safely into --full, never eval'd.
path_key() {
    if [[ "$1" == *[[:cntrl:]]* ]]; then
        local quoted
        printf -v quoted '%q' "$1"
        printf 'E:%s' "$quoted"
    else
        printf 'R:%s' "$1"
    fi
}

file_mode() {
    if [[ "$OS" == Darwin ]]; then stat -f '%Lp' "$1"; else stat -c '%a' -- "$1"; fi
}

base64_decode() {
    if [[ "$OS" == Darwin ]]; then base64 -D; else base64 -d; fi
}

tree_manifest() { # $1 root, $2 output
    local root="$1" out="$2" absolute rel key raw meta mode sha target
    find "$root" -mindepth 1 -print0 >"$out.paths" || die "diff: cannot enumerate $root"
    : >"$out.rows"
    while IFS= read -r -d '' absolute; do
        rel="${absolute#"$root"/}"
        key="$(path_key "$rel")"
        raw="$(printf '%s' "$rel" | base64 | tr -d '\r\n')" || die "diff: cannot encode a path"
        if [[ -L "$absolute" ]]; then
            # -n suppresses the output terminator on both GNU and BSD; a
            # sentinel preserves any newlines belonging to the target itself.
            target="$(readlink -n "$absolute" && printf .)" || die "diff: cannot read link $rel"
            target="${target%.}"
            meta="link:$(path_key "$target")"
        elif [[ -d "$absolute" ]]; then
            mode="$(file_mode "$absolute")" && meta="dir:$mode" || die "diff: cannot stat $rel"
        elif [[ -f "$absolute" ]]; then
            mode="$(file_mode "$absolute")" && sha="$(sha256 <"$absolute")" \
                && meta="file:$mode:$sha" || die "diff: cannot read $rel"
        elif [[ -p "$absolute" ]]; then
            meta="fifo:$(file_mode "$absolute")"
        elif [[ -S "$absolute" ]]; then
            meta="socket"
        elif [[ -b "$absolute" ]]; then
            meta="block"
        elif [[ -c "$absolute" ]]; then
            meta="char"
        else
            meta="other"
        fi
        printf '%s\t%s\t%s\n' "$key" "$meta" "$raw" >>"$out.rows" || die "diff: cannot write manifest"
    done <"$out.paths"
    LC_ALL=C sort "$out.rows" >"$out" || die "diff: cannot sort manifest"
}

emit_full_diff() { # $1 status, $2 display key, $3 base64 path
    local status="$1" display="${2#?:}" encoded="$3" rel="" before after left right rc=0
    IFS= read -r -d '' rel < <(printf '%s' "$encoded" | base64_decode; printf '\0')
    before="$DIFF_TMP/before/$rel"; after="$WORKSPACE/$rel"
    case "$status" in
        A) [[ -f "$after" && ! -L "$after" ]] || return 0; left=/dev/null; right="$after" ;;
        D) [[ -f "$before" && ! -L "$before" ]] || return 0; left="$before"; right=/dev/null ;;
        M)
            [[ -f "$before" && ! -L "$before" && -f "$after" && ! -L "$after" ]] || return 0
            left="$before"; right="$after" ;;
    esac
    diff -u --label "backup/$display" --label "now/$display" "$left" "$right" || rc=$?
    (( rc <= 1 )) || die "diff: cannot compare $display"
}

cmd_diff() {
    # diff(1) contract: 1 means changes only; explicit and unexpected errors
    # both return 2. This command exits explicitly after a complete comparison.
    ERROR_STATUS=2
    trap 'exit 2' ERR
    command -v base64 >/dev/null 2>&1 || die "diff: base64 is required"
    local file="" full=0 arg
    for arg in "$@"; do
        case "$arg" in
            --full) full=1 ;;
            -*) die "diff: unknown option $arg" ;;
            *) [[ -z "$file" ]] || die "diff: expected at most one BACKUP"; file="$arg" ;;
        esac
    done
    resolve_settings
    if [[ -z "$file" ]]; then
        file="$(latest_backup)" || die "diff: no backups for $WORKSPACE (take one with 'sapi backup' or run with --safer)"
    fi
    [[ -f "$file" ]] || die "diff: no such backup: $file"
    if [[ -f "$file.sha256" ]]; then
        [[ "$(awk '{print $1}' "$file.sha256")" == "$(sha256 <"$file")" ]] || die "diff: checksum mismatch for $file"
    else
        log "diff: warning: no checksum sidecar for $file; integrity is unverified"
    fi
    DIFF_TMP="$(umask 077 && mktemp -d "${TMPDIR:-/tmp}/sapi-diff.XXXXXX")"
    case "$DIFF_TMP/" in "$WORKSPACE"/*) die "diff: TMPDIR must be outside the workspace" ;; esac
    local tmp="$DIFF_TMP"
    mkdir -p "$tmp/before"
    tar -xzf "$file" -C "$tmp/before" --strip-components=1 || die "diff: cannot extract $file"
    tree_manifest "$tmp/before" "$tmp/before.manifest"
    tree_manifest "$WORKSPACE" "$tmp/now.manifest"

    local tab; tab="$(printf '\t')"
    awk -F '\t' '
        FILENAME == ARGV[1] { meta[$1] = $2; raw[$1] = $3; next }
        {
            if ($1 in meta) {
                if (meta[$1] != $2) print "M\t" $1 "\t" $3
                delete meta[$1]
            } else print "A\t" $1 "\t" $3
        }
        END { for (p in meta) print "D\t" p "\t" raw[p] }
    ' "$tmp/before.manifest" "$tmp/now.manifest" | LC_ALL=C sort -t "$tab" -k2,2 -k1,1 >"$tmp/changes"

    local added=0 deleted=0 modified=0 status key raw
    while IFS="$tab" read -r status key raw; do
        [[ -n "$status" ]] || continue
        printf '%s  %s\n' "$status" "${key#?:}"
        case "$status" in
            A) added=$((added + 1)) ;;
            D) deleted=$((deleted + 1)) ;;
            M) modified=$((modified + 1)) ;;
        esac
    done <"$tmp/changes"
    if (( full == 1 && added + modified + deleted > 0 )); then
        printf '\n'
        while IFS="$tab" read -r status key raw; do
            emit_full_diff "$status" "$key" "$raw"
        done <"$tmp/changes"
    fi
    log "diff: $added added, $modified modified, $deleted deleted · vs $(basename "$file")$( [[ -f "$file.run" ]] && printf ' · run exit %s' "$(awk -F' = ' '$1 == "exit_code" {print $2}' "$file.run")")"
    exit "$(( added + modified + deleted > 0 ))"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
while [[ "${1:-}" == --safer || "${1:-}" == --no-safer ]]; do
    [[ "$1" == --safer ]] && SAFER_FLAG=true || SAFER_FLAG=false
    shift
done
case "${1:-}" in
    ""|-*)
        case "${1:-}" in
            "") cmd_start ;;
            -h|--help) [[ $# -eq 1 ]] || die "usage: sapi help"; usage ;;
            -V|--version) [[ $# -eq 1 ]] || die "usage: sapi version"; printf '%s\n' "$SAPI_VERSION" ;;
            *) die "unknown option: $1 (see sapi help)" ;;
        esac ;;
    run)        shift; cmd_run "$@" ;;
    diff)       shift; cmd_diff "$@" ;;
    backup)     [[ $# -eq 1 ]] || die "usage: sapi backup"; cmd_backup ;;
    backups)    [[ $# -eq 1 ]] || die "usage: sapi backups"; cmd_backups ;;
    restore)    shift; cmd_restore "$@" ;;
    config)     shift; cmd_config "$@" ;;
    help)       [[ $# -eq 1 ]] || die "usage: sapi help"; usage ;;
    version)    [[ $# -eq 1 ]] || die "usage: sapi version"; printf '%s\n' "$SAPI_VERSION" ;;
    dockerfile) [[ $# -eq 1 ]] || die "usage: sapi dockerfile"; cmd_dockerfile ;;
    build)      [[ $# -eq 1 ]] || die "usage: sapi build"; cmd_build ;;
    ls)         [[ $# -eq 1 ]] || die "usage: sapi ls"; cmd_ls ;;
    rm)         [[ $# -le 2 && ( $# -eq 1 || "$2" == --all ) ]] || die "usage: sapi rm [--all]"; cmd_rm "${2:-}" ;;
    shell)      shift; cmd_shell "$@" ;;
    netlog)     [[ $# -le 2 ]] || die "usage: sapi netlog [NAME]"; cmd_netlog "${2:-}" ;;
    upgrade)    [[ $# -eq 1 ]] || die "usage: sapi upgrade"; cmd_upgrade ;;
    *)          [[ $# -eq 1 ]] || die "expected at most one container name (see sapi help)"
                cmd_start "$1" ;;
esac
