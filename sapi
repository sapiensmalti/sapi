#!/usr/bin/env bash
# sapi — the pi coding agent, isolated in Docker, scoped to the directory you run it from.
# https://github.com/sapiensmalti/sapi
#
# One file. No dependencies beyond bash, docker and coreutils.
set -Eeuo pipefail

readonly SAPI_VERSION="0.4.0"
readonly SAPI_REPO="${SAPI_REPO:-sapiensmalti/sapi}"
readonly SAPI_REF="${SAPI_REF:-main}"
readonly IMAGE_REPOSITORY="sapi"
readonly CONFIG_VOLUME="${SAPI_CONFIG_VOLUME:-sapi-config}"
readonly LABEL="sh.sapi"

# ---------------------------------------------------------------------------
# Image definition. Embedded so that `sapi` is a single file.
# Print it with `sapi dockerfile`.
# ---------------------------------------------------------------------------
read -r -d '' DOCKERFILE <<'DOCKERFILE_EOF' || true
# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim

ARG PI_VERSION=latest

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TERM=xterm-256color \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates curl git jq less openssh-client procps ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*' \
    && mkdir -p /home/sapi /pi-config /pi-sessions

RUN npm install --global --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && npm cache clean --force \
    && pi --version

# uv gives the agent Python without touching the host. Two static binaries.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Entrypoint: optional self-update, then drop to the host user (Linux) so files
# written to /workspace are owned by you, not root.
COPY <<'ENTRYPOINT_EOF' /usr/local/bin/sapi-entrypoint
#!/bin/bash
set -eu
if [ "${SAPI_AUTO_UPDATE:-1}" = "1" ]; then
    pi update self --no-approve >&2 \
        || printf 'sapi: pi update failed; using installed pi %s\n' "$(pi --version 2>/dev/null)" >&2
fi
uid="${SAPI_UID:-0}"
gid="${SAPI_GID:-0}"
if [ "$uid" != "0" ]; then
    for dir in /pi-config /pi-sessions /home/sapi; do
        [ "$(stat -c '%u:%g' "$dir")" = "$uid:$gid" ] || chown -R "$uid:$gid" "$dir"
    done
    exec setpriv --reuid "$uid" --regid "$gid" --clear-groups \
        env HOME=/home/sapi USER=sapi pi "$@"
fi
exec pi "$@"
ENTRYPOINT_EOF
RUN chmod 0755 /usr/local/bin/sapi-entrypoint

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/sapi-entrypoint"]
DOCKERFILE_EOF
readonly DOCKERFILE

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
die() { printf 'sapi: %s\n' "$*" >&2; exit 1; }
log() { printf 'sapi: %s\n' "$*" >&2; }

usage() {
    cat <<EOF
sapi $SAPI_VERSION — the pi coding agent, isolated in Docker, scoped to this directory.

Usage:
  sapi [--safer|--no-safer] [NAME]
                     Start (or resume) an agent in the current directory
  sapi run [--json] [--timeout S] TASK
                     Headless: one task, final message on stdout, agent's exit code ('-' reads TASK from stdin)
  sapi backup        Back up this directory now (what --safer does before every start)
  sapi backups       List this directory's backups
  sapi diff [BACKUP] [--full]
                     What changed since the latest (or given) backup: A/M/D per path; --full for a unified diff
  sapi restore FILE|latest [DEST]
                     Restore a backup into DEST (default: a new sibling directory; never in place)
  sapi restore FILE|latest --files PATH...
                     Put back only the named paths, in place
  sapi config [show | set KEY VALUE | keys | path]
                     Show or change persistent settings
  sapi ls            List sapi containers
  sapi rm [--all]    Remove this directory's containers (or all of them)
  sapi shell [NAME]  Open a bash shell inside the running container
  sapi build         Build the image without starting a container
  sapi dockerfile    Print the embedded Dockerfile
  sapi upgrade       Upgrade sapi itself
  sapi version       Print version
  sapi help          Show this help

Environment:
  SAPI_MODEL          Model for pi --model (default: pi decides)
  SAPI_PI_VERSION     pi npm version to install in the image (default: latest)
  SAPI_AUTO_UPDATE=0  Do not run 'pi update' on container start
  SAPI_REBUILD=1      Rebuild the image from scratch
  SAPI_UID / SAPI_GID Container user (default: your uid/gid on Linux, root on macOS)
  SAPI_CONFIG_VOLUME  Docker volume for pi config and credentials (default: sapi-config)
  SAPI_ENV            Space-separated host variables to pass through, e.g. "ANTHROPIC_API_KEY GH_TOKEN"
  SAPI_DOCKER_ARGS    Extra arguments for 'docker create' (split on whitespace)
  SAPI_SAFER=1        Back up the directory before every start; abort if that fails
  SAPI_BACKUP_DIR     Where backups go (default: ~/.local/share/sapi/backups); must be outside the directory
  SAPI_BACKUP_KEEP    Backups to keep per directory (default: 10; 0 = keep all)

  SAPI_CPUS / SAPI_MEMORY_MIB / SAPI_PIDS
                      Resource ceilings for the agent container (default: unlimited / unlimited / 4096)
  SAPI_PACKAGES       Extra Debian packages baked into the image, e.g. "golang make"
  SAPI_DOCKERFILE_EXTRA
                      Dockerfile fragment appended to the image (default: ~/.config/sapi/Dockerfile.extra)

Config file ($CONFIG_FILE), 'key = value' ('sapi config keys' lists them):
$(setting_help)
Precedence: flag > environment > config file > default.

Inside the agent:  detach with Ctrl-P, Ctrl-Q.  Reattach with 'sapi'.
Docs: https://github.com/$SAPI_REPO
EOF
}

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{print $1}'
    else die "need sha256sum or shasum"; fi
}

sanitize() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9_.-]+/-/g; s/^[-_.]+//; s/[-_.]+$//'
}

inspect() { docker container inspect --format "$2" "$1" 2>/dev/null || true; }
label()   { inspect "$1" "{{index .Config.Labels \"$LABEL.$2\"}}"; }

require_docker() {
    command -v docker >/dev/null 2>&1 || die "docker not found. See: https://github.com/$SAPI_REPO#install"
    if ! docker info >/dev/null 2>&1; then
        if [[ "$OS" == "Darwin" ]] && command -v open >/dev/null 2>&1; then
            log "Docker is not running; trying to start OrbStack or Docker Desktop ..."
            open -gj -a OrbStack >/dev/null 2>&1 || open -gj -a Docker >/dev/null 2>&1 || true
            for _ in $(seq 1 30); do docker info >/dev/null 2>&1 && break; sleep 1; done
        fi
    fi
    docker info >/dev/null 2>&1 || die "Docker is not running or you lack permission (on Linux: sudo usermod -aG docker \$USER, then re-login)."
}

# ---------------------------------------------------------------------------
# Context
# ---------------------------------------------------------------------------
OS="$(uname -s)"
WORKSPACE="$(pwd -P)"
WORKSPACE_HASH="$(printf '%s' "$WORKSPACE" | sha256)"
CONFIG_FILE="${SAPI_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/sapi/config}"
readonly CONFIG_FILE
PI_VERSION="${SAPI_PI_VERSION:-latest}"
MODEL="${SAPI_MODEL:-}"
REBUILD="${SAPI_REBUILD:-0}"
AUTO_UPDATE="${SAPI_AUTO_UPDATE:-1}"
if [[ "$OS" == "Linux" ]]; then
    UID_="${SAPI_UID:-$(id -u)}"; GID_="${SAPI_GID:-$(id -g)}"
else
    UID_="${SAPI_UID:-0}"; GID_="${SAPI_GID:-0}"
fi
readonly OS WORKSPACE WORKSPACE_HASH PI_VERSION MODEL REBUILD AUTO_UPDATE UID_ GID_

[[ "$REBUILD" == 0 || "$REBUILD" == 1 ]] || die "SAPI_REBUILD must be 0 or 1"
[[ "$AUTO_UPDATE" == 0 || "$AUTO_UPDATE" == 1 ]] || die "SAPI_AUTO_UPDATE must be 0 or 1"
[[ "$UID_$GID_" =~ ^[0-9]+$ ]] || die "SAPI_UID and SAPI_GID must be integers"

# The effective Dockerfile is the embedded one plus the user's toolchain
# customisation (see `packages` and `dockerfile_extra`). The image tag is a
# hash of everything that goes into it, so any change yields a new image and
# an unchanged definition is never rebuilt. Resolved after settings are read.
IMAGE=""; EFFECTIVE_DOCKERFILE=""
resolve_image() {
    [[ -n "$IMAGE" ]] && return 0
    EFFECTIVE_DOCKERFILE="$DOCKERFILE"
    if [[ -n "${SET_packages:-}" ]]; then
        EFFECTIVE_DOCKERFILE+="
# --- sapi: packages (from \`sapi config\` / SAPI_PACKAGES) ---
RUN apt-get update \\
    && apt-get install -y --no-install-recommends $SET_packages \\
    && rm -rf /var/lib/apt/lists/*"
    fi
    if [[ -n "${SET_dockerfile_extra:-}" && -f "$SET_dockerfile_extra" ]]; then
        [[ -r "$SET_dockerfile_extra" ]] || die "cannot read $SET_dockerfile_extra"
        EFFECTIVE_DOCKERFILE+="
# --- sapi: $SET_dockerfile_extra ---
$(cat "$SET_dockerfile_extra")"
    fi
    IMAGE="${SAPI_IMAGE:-$IMAGE_REPOSITORY:$(printf '%s\n%s\n' "$PI_VERSION" "$EFFECTIVE_DOCKERFILE" | sha256 | cut -c1-12)}"
}

# ---------------------------------------------------------------------------
# Config file
#
# Plain 'key = value' lines, '#' comments. Parsed with a whitelist and never
# sourced. An unknown key or an invalid value refuses to start: a safety
# setting that is silently ignored because of a typo is worse than none.
# ---------------------------------------------------------------------------
# Settings are declared once, here. Each has a type, an environment variable
# and a default; the same table drives parsing, precedence and `sapi config`.
readonly SETTING_KEYS="safer backup_dir backup_keep cpus memory_mib pids packages dockerfile_extra"
setting_spec() {  # $1 key -> "type env default"
    case "$1" in
        safer)       printf 'bool SAPI_SAFER false' ;;
        backup_dir)  printf 'path SAPI_BACKUP_DIR %s' "${XDG_DATA_HOME:-$HOME/.local/share}/sapi/backups" ;;
        backup_keep) printf 'uint SAPI_BACKUP_KEEP 10' ;;
        cpus)        printf 'number SAPI_CPUS 0' ;;
        memory_mib)  printf 'uint SAPI_MEMORY_MIB 0' ;;
        pids)        printf 'uint SAPI_PIDS 4096' ;;
        packages)    printf 'packages SAPI_PACKAGES ' ;;
        dockerfile_extra) printf 'path SAPI_DOCKERFILE_EXTRA %s' "$(dirname "$CONFIG_FILE")/Dockerfile.extra" ;;
        *) return 1 ;;
    esac
}
setting_help() {
    cat <<'HELP'
  safer        bool    back up the directory before every start; abort if that fails
  backup_dir   path    where backups go (absolute; must be outside the directory)
  backup_keep  uint    backups kept per directory (0 = keep all)
  cpus         number  CPU ceiling for the agent container (0 = unlimited)
  memory_mib   uint    memory ceiling in MiB (0 = unlimited)
  pids         uint    process ceiling (0 = unlimited)
  packages     list    extra Debian packages baked into the image, e.g. "golang make postgresql-client"
  dockerfile_extra path  Dockerfile fragment appended to the image when the file exists
                       (default: ~/.config/sapi/Dockerfile.extra; user-level only, never from a project)
HELP
}

# Validate a value for a key; print the normalised value or die.
validate_setting() {  # $1 key, $2 value, $3 where (for messages)
    local spec type; spec="$(setting_spec "$1")" || die "unknown setting '$1' (known: $SETTING_KEYS)"
    type="${spec%% *}"
    local v="$2" where="${3:-$1}"
    case "$type" in
        bool)
            case "$(printf '%s' "$v" | tr '[:upper:]' '[:lower:]')" in
                1|true|yes|on)  printf true ;;
                0|false|no|off) printf false ;;
                *) die "$where must be true or false, got '$v'" ;;
            esac ;;
        uint)   [[ "$v" =~ ^[0-9]+$ ]] || die "$where must be a non-negative integer, got '$v'"; printf '%s' "$v" ;;
        number) [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "$where must be a non-negative number, got '$v'"; printf '%s' "$v" ;;
        path)   [[ "$v" == /* ]] || die "$where must be an absolute path, got '$v'"; printf '%s' "$v" ;;
        packages)
            # Debian package names, whitespace or comma separated; normalised to one space.
            local p out=""
            for p in $(printf '%s' "$v" | tr ',' ' '); do
                [[ "$p" =~ ^[a-z0-9][a-z0-9+.-]+$ ]] || die "$where: '$p' is not a valid Debian package name"
                out+="${out:+ }$p"
            done
            printf '%s' "$out" ;;
    esac
}

# Parse the config file into CFG_<key>. Whitelisted keys, validated values,
# never sourced. Unknown keys or invalid values refuse to start: a safety
# setting silently ignored because of a typo is worse than none.
load_config() {
    [[ -f "$CONFIG_FILE" ]] || return 0
    [[ -r "$CONFIG_FILE" ]] || die "cannot read $CONFIG_FILE"
    local line n=0 key value
    while IFS= read -r line || [[ -n "$line" ]]; do
        n=$((n + 1))
        line="${line%%#*}"
        line="$(printf '%s' "$line" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
        [[ -z "$line" ]] && continue
        [[ "$line" =~ ^([a-z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]] \
            || die "$CONFIG_FILE:$n: expected 'key = value', got '$line'"
        key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
        value="$(validate_setting "$key" "$value" "$CONFIG_FILE:$n: $key")" || exit 1
        printf -v "CFG_$key" '%s' "$value"
    done <"$CONFIG_FILE"
}

# Effective settings into SET_<key> / SRC_<key>.
# Precedence: flag > environment > config file > default.
SAFER_FLAG=""   # set by --safer / --no-safer
SET_safer=""; SET_backup_dir=""; SET_backup_keep=""; SET_cpus=""; SET_memory_mib=""; SET_pids=""; SET_packages=""; SET_dockerfile_extra=""
resolve_settings() {
    load_config
    local key spec env default cfg_var env_val
    for key in $SETTING_KEYS; do
        spec="$(setting_spec "$key")"
        env="$(printf '%s' "$spec" | awk '{print $2}')"
        default="${spec#* * }"
        cfg_var="CFG_$key"
        env_val="${!env:-}"
        if [[ "$key" == safer && -n "$SAFER_FLAG" ]]; then
            printf -v "SET_$key" '%s' "$SAFER_FLAG"; printf -v "SRC_$key" flag
        elif [[ -n "$env_val" ]]; then
            printf -v "SET_$key" '%s' "$(validate_setting "$key" "$env_val" "$env")" || exit 1
            printf -v "SRC_$key" environment
        elif [[ -n "${!cfg_var:-}" ]]; then
            printf -v "SET_$key" '%s' "${!cfg_var}"; printf -v "SRC_$key" config
        else
            printf -v "SET_$key" '%s' "$default"; printf -v "SRC_$key" default
        fi
    done
    SAFER="$SET_safer"; BACKUP_DIR="$SET_backup_dir"; BACKUP_KEEP="$SET_backup_keep"
}

cmd_config() {
    case "${1:-show}" in
        show)
            resolve_settings
            printf 'config file  %s%s\n' "$CONFIG_FILE" "$([[ -f "$CONFIG_FILE" ]] || printf ' (absent)')"
            local key v s
            for key in $SETTING_KEYS; do
                v="SET_$key"; s="SRC_$key"
                printf '%-12s %s  (%s)\n' "$key" "${!v}" "${!s}"
            done ;;
        path) printf '%s\n' "$CONFIG_FILE" ;;
        keys) setting_help ;;
        set)
            [[ $# -eq 3 ]] || die "usage: sapi config set KEY VALUE"
            local key="$2" value
            value="$(validate_setting "$key" "$3")" || exit 1
            load_config  # refuse to edit a file we cannot parse
            local dir tmp; dir="$(dirname "$CONFIG_FILE")"
            (umask 077 && mkdir -p "$dir") || die "cannot create $dir"
            tmp="$(umask 077 && mktemp "$dir/.config.XXXXXX")" || die "cannot write to $dir"
            if [[ -f "$CONFIG_FILE" ]] && grep -Eq "^[[:space:]]*${key}[[:space:]]*=" "$CONFIG_FILE"; then
                awk -v k="$key" -v v="$value" '
                    $0 ~ "^[[:space:]]*" k "[[:space:]]*=" && !done { print k " = " v; done = 1; next }
                    { print }' "$CONFIG_FILE" >"$tmp"
            else
                { [[ -f "$CONFIG_FILE" ]] && cat "$CONFIG_FILE"; printf '%s = %s\n' "$key" "$value"; } >"$tmp"
            fi
            mv -f "$tmp" "$CONFIG_FILE"
            log "$key = $value  ($CONFIG_FILE)" ;;
        *) die "usage: sapi config [show | set KEY VALUE | keys | path]" ;;
    esac
}

# ---------------------------------------------------------------------------
# Backups
#
# A backup is a tar.gz of the whole directory, taken from its parent, with
# symlinks preserved and nothing excluded, written outside the directory so
# the agent cannot reach it. It is written to a .partial file, verified by
# re-listing the archive, checksummed, then renamed into place: a half-written
# backup never looks like a finished one. Any failure aborts the launch.
# ---------------------------------------------------------------------------
backup_root() { printf '%s/%s-%s' "$BACKUP_DIR" "$(sanitize "$(basename "$WORKSPACE")")" "${WORKSPACE_HASH:0:8}"; }

backup_create() {
    command -v tar >/dev/null 2>&1 || die "backup: tar is required"
    [[ "$WORKSPACE" != "/" ]] || die "backup: refusing to back up /"
    local root; root="$(backup_root)"
    local inside="backup: $BACKUP_DIR is inside $WORKSPACE; a backup must live outside the directory it protects. Set SAPI_BACKUP_DIR elsewhere."
    # Check before creating anything, then again on the resolved path (symlinks).
    case "$BACKUP_DIR/" in "$WORKSPACE"/*) die "$inside" ;; esac
    (umask 077 && mkdir -p "$root") || die "backup: cannot create $root"
    local root_real; root_real="$(cd -- "$root" && pwd -P)"
    case "$root_real/" in
        "$WORKSPACE"/*) rmdir -p -- "$root" 2>/dev/null || true; die "$inside" ;;
    esac

    local need have
    need="$(du -sk -- "$WORKSPACE" 2>/dev/null | awk '{print $1}')"; need="${need:-0}"
    have="$(df -Pk -- "$root_real" | awk 'NR == 2 {print $4}')"
    [[ "$have" =~ ^[0-9]+$ ]] || die "backup: cannot determine free space at $root_real"
    (( have > need + 65536 )) || die "backup: not enough space at $root_real (need ~$((need / 1024)) MiB, have $((have / 1024)) MiB)"

    local stamp name final partial
    # Names are UTC stamps and must sort chronologically, so a same-second
    # collision waits for the next second instead of adding a suffix.
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    while [[ -e "$root/$stamp.tar.gz" ]]; do sleep 1; stamp="$(date -u +%Y%m%dT%H%M%SZ)"; done
    name="$stamp.tar.gz"
    final="$root/$name"; partial="$root/.$name.partial"
    BACKUP_PARTIAL="$partial"
    trap '[[ -n "${BACKUP_PARTIAL:-}" ]] && rm -f -- "$BACKUP_PARTIAL"' EXIT

    log "backup: archiving $WORKSPACE (~$((need / 1024)) MiB) ..."
    local started rc=0
    started="$(date +%s)"
    (umask 077 && cd -- "$(dirname "$WORKSPACE")" && COPYFILE_DISABLE=1 tar -czf "$partial" -- "$(basename "$WORKSPACE")") || rc=$?
    # GNU tar exits 1 when a file changed while being read: the archive is
    # complete but that file may be inconsistent. Anything worse is fatal.
    (( rc <= 1 )) || { rm -f -- "$partial"; die "backup: tar failed (exit $rc); nothing was started"; }
    (( rc == 0 )) || log "backup: warning: some files changed while being archived"

    local entries sha bytes
    entries="$(tar -tzf "$partial" | wc -l | tr -d ' ')" || { rm -f -- "$partial"; die "backup: archive failed verification"; }
    (( entries > 0 )) || { rm -f -- "$partial"; die "backup: archive is empty"; }
    sha="$(sha256 <"$partial")"
    bytes="$(wc -c <"$partial" | tr -d ' ')"
    mv -f -- "$partial" "$final"
    BACKUP_PARTIAL=""
    (umask 077
     printf '%s  %s\n' "$sha" "$name" >"$final.sha256"
     printf 'source = %s\ncreated_utc = %s\nsapi_version = %s\nhost = %s\nentries = %s\nbytes = %s\nsha256 = %s\ntar_exit = %s\nduration_s = %s\n' \
        "$WORKSPACE" "$stamp" "$SAPI_VERSION" "$(hostname 2>/dev/null || echo unknown)" "$entries" "$bytes" "$sha" "$rc" "$(( $(date +%s) - started ))" >"$final.manifest")
    BACKUP_PATH="$final"
    log "backup: $final ($((bytes / 1024 / 1024)) MiB, $entries entries, $(( $(date +%s) - started ))s)"
    backup_prune "$root"
}

# Remove the oldest backups beyond BACKUP_KEEP. Only our own files, only in
# our own directory; names sort chronologically because they are UTC stamps.
backup_prune() {
    (( BACKUP_KEEP > 0 )) || return 0
    local root="$1" f count
    count="$(find "$root" -maxdepth 1 -name '*.tar.gz' -type f | wc -l | tr -d ' ')"
    (( count > BACKUP_KEEP )) || return 0
    find "$root" -maxdepth 1 -name '*.tar.gz' -type f | sort | head -n $((count - BACKUP_KEEP)) | while IFS= read -r f; do
        rm -f -- "$f" "$f.sha256" "$f.manifest"
        log "backup: pruned $(basename "$f")"
    done
}

cmd_backup() { resolve_settings; backup_create; printf '%s\n' "$BACKUP_PATH"; }

cmd_backups() {
    resolve_settings
    local root f; root="$(backup_root)"
    [[ -d "$root" ]] || { log "no backups for $WORKSPACE"; return 0; }
    find "$root" -maxdepth 1 -name '*.tar.gz' -type f | sort | while IFS= read -r f; do
        printf '%s\t%s MiB\n' "$f" "$(( $(wc -c <"$f" | tr -d ' ') / 1024 / 1024 ))"
    done
}

cmd_restore() {
    local file="${1:-}" dest="${2:-}"
    [[ -n "$file" ]] || die "usage: sapi restore FILE [DEST] | sapi restore FILE --files PATH..."
    [[ "$file" == latest ]] && { resolve_settings; file="$(latest_backup)" || die "restore: no backups for $WORKSPACE"; }
    [[ -f "$file" ]] || die "restore: no such file: $file"
    if [[ -f "$file.sha256" ]]; then
        local want have
        want="$(awk '{print $1}' "$file.sha256")"; have="$(sha256 <"$file")"
        [[ "$want" == "$have" ]] || die "restore: checksum mismatch for $file; refusing to restore a corrupt backup"
    else
        log "restore: warning: no checksum sidecar for $file"
    fi
    tar -tzf "$file" >/dev/null 2>&1 || die "restore: $file is not a readable tar.gz"

    if [[ "$dest" == --files ]]; then
        # Selective, in-place restore: the one operation that writes into the
        # workspace, and only the paths named, explicitly, by the user.
        shift 2
        [[ $# -gt 0 ]] || die "restore: --files needs at least one path"
        local top p members=()
        top="$(tar -tzf "$file" | head -n 1)"; top="${top%%/*}"
        for p in "$@"; do
            [[ "$p" != /* && "$p" != *..* ]] || die "restore: paths must be relative and inside the directory: $p"
            p="${p%/}"
            tar -tzf "$file" -- "$top/$p" >/dev/null 2>&1 || die "restore: '$p' is not in the backup"
            members+=("$top/$p")
        done
        tar -xzf "$file" -C "$WORKSPACE" --strip-components=1 -- "${members[@]}" || die "restore: extraction failed"
        for p in "$@"; do printf 'restored  %s\n' "${p%/}"; done
        return 0
    fi

    [[ -n "$dest" ]] || dest="$WORKSPACE.restored-$(date -u +%Y%m%dT%H%M%SZ)"
    if [[ -e "$dest" ]]; then
        [[ -d "$dest" ]] || die "restore: $dest exists and is not a directory"
        [[ -z "$(ls -A -- "$dest")" ]] || die "restore: $dest is not empty; restores never overwrite"
    else
        mkdir -p -- "$dest" || die "restore: cannot create $dest"
    fi
    tar -xzf "$file" -C "$dest" --strip-components=1 || die "restore: extraction failed"
    log "restored to $dest"
    printf '%s\n' "$dest"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_build() {
    resolve_settings; resolve_image; require_docker
    if [[ "$REBUILD" == 1 ]] || ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
        local opts=(--tag "$IMAGE" --build-arg "PI_VERSION=$PI_VERSION")
        [[ "$REBUILD" == 1 ]] && opts+=(--no-cache --pull)
        log "building $IMAGE ...${SET_packages:+ (packages: $SET_packages)}"
        local ctx; ctx="$(mktemp -d)"
        printf '%s\n' "$EFFECTIVE_DOCKERFILE" | DOCKER_BUILDKIT=1 docker build "${opts[@]}" -f - "$ctx"
        rmdir "$ctx"
    fi
}

cmd_dockerfile() { resolve_settings; resolve_image; printf '%s\n' "$EFFECTIVE_DOCKERFILE"; }

cmd_ls() {
    require_docker
    docker container ls --all --filter "label=$LABEL.managed=true" \
        --format 'table {{.Names}}\t{{.Status}}\t{{.Label "sh.sapi.workspace"}}'
}

cmd_rm() {
    require_docker
    local filter=("--filter" "label=$LABEL.managed=true")
    [[ "${1:-}" == "--all" ]] || filter+=("--filter" "label=$LABEL.workspace-hash=$WORKSPACE_HASH")
    local names
    names="$(docker container ls --all "${filter[@]}" --format '{{.Names}}')"
    [[ -n "$names" ]] || { log "nothing to remove"; return 0; }
    local n
    for n in $names; do
        local vol; vol="$(label "$n" sessions-volume)"
        docker container rm --force "$n" >/dev/null && log "removed container $n"
        [[ -n "$vol" ]] && docker volume rm "$vol" >/dev/null 2>&1 && log "removed volume $vol"
    done
    log "kept config volume $CONFIG_VOLUME (credentials). Remove with: docker volume rm $CONFIG_VOLUME"
}

cmd_shell() {
    require_docker
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        name="$(docker container ls --filter "label=$LABEL.workspace-hash=$WORKSPACE_HASH" --format '{{.Names}}' | head -n1)"
        [[ -n "$name" ]] || die "no running container for $WORKSPACE"
    fi
    exec docker exec --interactive --tty --user "$UID_:$GID_" --env HOME=/home/sapi "$name" bash
}

cmd_upgrade() {
    command -v curl >/dev/null 2>&1 || die "curl is required"
    local url="https://raw.githubusercontent.com/$SAPI_REPO/$SAPI_REF/install.sh"
    log "fetching $url"
    curl -fsSL "$url" | SAPI_INSTALL_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" bash
}

# The container specification shared by `sapi` and `sapi run`: one place for
# mounts, environment, hardening and resource ceilings. Prints one argument
# per line (read back into an array by the callers).
container_args() {  # $1 container name, $2 sessions volume
    local name="$1" sessions="$2"
    local -a a=(--init --name "$name" --hostname sapi
        --label "$LABEL.managed=true" --label "$LABEL.version=$SAPI_VERSION"
        --label "$LABEL.workspace=$WORKSPACE" --label "$LABEL.workspace-hash=$WORKSPACE_HASH"
        --label "$LABEL.model=$MODEL" --label "$LABEL.user=$UID_:$GID_" --label "$LABEL.auto-update=$AUTO_UPDATE"
        --volume "$WORKSPACE:/workspace"
        --mount "type=volume,source=$CONFIG_VOLUME,target=/pi-config"
        --mount "type=volume,source=$sessions,target=/pi-sessions"
        --workdir /workspace
        --env PI_CODING_AGENT_DIR=/pi-config --env PI_CODING_AGENT_SESSION_DIR=/pi-sessions
        --env GIT_CONFIG_GLOBAL=/pi-config/gitconfig
        --env "SAPI_AUTO_UPDATE=$AUTO_UPDATE" --env "SAPI_UID=$UID_" --env "SAPI_GID=$GID_"
        --security-opt no-new-privileges --cap-drop ALL
        --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add DAC_READ_SEARCH --cap-add FOWNER
        --cap-add SETUID --cap-add SETGID --cap-add SETPCAP)
    # Resource ceilings (0 = unlimited).
    [[ "$SET_cpus" != 0 && "$SET_cpus" != 0.0 ]] && a+=(--cpus "$SET_cpus")
    [[ "$SET_memory_mib" != 0 ]] && a+=(--memory "${SET_memory_mib}m")
    [[ "$SET_pids" != 0 ]] && a+=(--pids-limit "$SET_pids")
    local var
    for var in ${SAPI_ENV:-}; do
        [[ "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "SAPI_ENV: invalid variable name '$var'"
        [[ -n "${!var:-}" ]] || log "warning: SAPI_ENV variable $var is unset"
        a+=(--env "$var")
    done
    # shellcheck disable=SC2206
    [[ -n "${SAPI_DOCKER_ARGS:-}" ]] && a+=($SAPI_DOCKER_ARGS)
    printf '%s\n' "${a[@]}"
}

attach() {
    local name="$1"
    printf '\n  container  %s\n  workspace  %s\n  config     %s\n  sessions   %s\n  user       %s\n' \
        "$name" "$WORKSPACE" "$CONFIG_VOLUME" "$(label "$name" sessions-volume)" "$UID_:$GID_" >&2
    [[ -n "${BACKUP_PATH:-}" ]] && printf '  backup     %s\n' "$BACKUP_PATH" >&2
    printf '  detach     Ctrl-P, Ctrl-Q\n\n' >&2
    exec docker start --attach --interactive "$name"
}

cmd_start() {
    [[ -t 0 && -t 1 ]] || die "an interactive terminal is required"
    resolve_settings
    cmd_build
    # Snapshot the directory right before the agent gets access to it.
    BACKUP_PATH=""
    [[ "$SAFER" == true ]] && backup_create
    local image_id; image_id="$(docker image inspect --format '{{.Id}}' "$IMAGE")"

    local base
    if [[ -n "${1:-}" ]]; then base="$(sanitize "$1")"
    else
        local ws; ws="$(sanitize "$(basename "$WORKSPACE")")"; ws="${ws:-workspace}"
        base="sapi-${ws:0:36}-${WORKSPACE_HASH:0:8}"
    fi
    [[ -n "$base" ]] || die "invalid container name"
    base="${base:0:54}"

    docker volume create "$CONFIG_VOLUME" >/dev/null

    # Find a free slot: resume a compatible stopped container, replace an
    # incompatible one, or allocate a new slot if one is already running.
    local slot=1 name sessions
    while :; do
        name="$base"; [[ "$slot" -gt 1 ]] && name="$base-$slot"
        sessions="$name-sessions"
        docker container inspect "$name" >/dev/null 2>&1 || break
        if [[ "$(label "$name" managed)" != "true" || "$(label "$name" workspace-hash)" != "$WORKSPACE_HASH" ]]; then
            slot=$((slot + 1)); continue
        fi
        case "$(inspect "$name" '{{.State.Status}}')" in
            created | exited | dead)
                if [[ "$(inspect "$name" '{{.Image}}')" == "$image_id" \
                    && "$(label "$name" version)" == "$SAPI_VERSION" \
                    && "$(label "$name" model)" == "$MODEL" \
                    && "$(label "$name" user)" == "$UID_:$GID_" \
                    && "$(label "$name" auto-update)" == "$AUTO_UPDATE" ]]; then
                    log "resuming $name"
                    attach "$name"
                fi
                log "refreshing $name (image or settings changed; sessions are kept)"
                docker container rm --force "$name" >/dev/null
                break ;;
            *) slot=$((slot + 1)); continue ;;
        esac
    done

    docker volume create "$sessions" >/dev/null

    local pi_args=(--continue)
    [[ -n "$MODEL" ]] && pi_args+=(--model "$MODEL")
    local -a args=()
    while IFS= read -r line; do args+=("$line"); done < <(container_args "$name" "$sessions")

    docker create --interactive --tty \
        --label "$LABEL.sessions-volume=$sessions" \
        "${args[@]}" \
        "$IMAGE" "${pi_args[@]}" >/dev/null \
        || die "could not create container $name"

    attach "$name"
}

# ---------------------------------------------------------------------------
# Headless: sapi run TASK
#
# One ephemeral container, one task, the agent's final message on stdout,
# the agent's exit code. Progress and diagnostics on stderr. With safer mode
# the run is bracketed by a backup before and a run manifest after, so a cron
# job leaves behind: what it was asked, what the tree looked like before, what
# it answered, how it exited, and (via `sapi diff`) exactly what it changed.
# ---------------------------------------------------------------------------
cmd_run() {
    local json=0 timeout=0 task_parts=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json=1; shift ;;
            --timeout) [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--timeout needs seconds"; timeout="$2"; shift 2 ;;
            --timeout=*) timeout="${1#*=}"; [[ "$timeout" =~ ^[0-9]+$ ]] || die "--timeout needs seconds"; shift ;;
            --) shift; task_parts+=("$@"); break ;;
            -) task_parts+=("$(cat)"); shift ;;
            -*) die "run: unknown option $1 (options: --json, --timeout SECONDS)" ;;
            *) task_parts+=("$1"); shift ;;
        esac
    done
    local task="${task_parts[*]:-}"
    [[ -n "${task//[[:space:]]/}" ]] || die "usage: sapi run [--json] [--timeout SECONDS] TASK  (or '-' to read TASK from stdin)"

    resolve_settings
    cmd_build
    BACKUP_PATH=""
    [[ "$SAFER" == true ]] && backup_create

    local ws; ws="$(sanitize "$(basename "$WORKSPACE")")"; ws="${ws:-workspace}"
    local base="sapi-${ws:0:36}-${WORKSPACE_HASH:0:8}"
    local sessions="$base-runs-sessions"
    local name; name="$base-run-$(date -u +%Y%m%dT%H%M%SZ)-$$"
    docker volume create "$CONFIG_VOLUME" >/dev/null
    docker volume create "$sessions" >/dev/null

    local pi_args=(-p --no-approve)
    [[ "$json" == 1 ]] && pi_args+=(--mode json)
    [[ -n "$MODEL" ]] && pi_args+=(--model "$MODEL")
    pi_args+=(--name "sapi run $(date -u +%Y-%m-%dT%H:%M:%SZ)" -- "$task")

    local -a args=()
    while IFS= read -r line; do args+=("$line"); done < <(container_args "$name" "$sessions")

    local started rc=0
    started="$(date +%s)"
    log "run: $name"
    # docker run in the background so a timeout can stop it cleanly; stdout
    # flows straight through to ours.
    docker run --rm --label "$LABEL.run=true" "${args[@]}" "$IMAGE" "${pi_args[@]}" &
    local dpid=$!
    if (( timeout > 0 )); then
        ( sleep "$timeout"; docker stop --time 10 "$name" >/dev/null 2>&1 ) &
        local tpid=$!
        wait "$dpid" || rc=$?
        kill "$tpid" 2>/dev/null || true
        if (( $(date +%s) - started >= timeout )) && (( rc != 0 )); then rc=124; log "run: timed out after ${timeout}s"; fi
    else
        wait "$dpid" || rc=$?
    fi

    if [[ -n "$BACKUP_PATH" ]]; then
        (umask 077; printf 'task = %s\ncontainer = %s\nstarted_utc = %s\nfinished_utc = %s\nexit_code = %s\nmodel = %s\nsapi_version = %s\n' \
            "$(printf '%s' "$task" | head -c 2000 | tr '\n' ' ')" "$name" "$(date -u -r "$started" +%Y%m%dT%H%M%SZ 2>/dev/null || date -u -d "@$started" +%Y%m%dT%H%M%SZ)" \
            "$(date -u +%Y%m%dT%H%M%SZ)" "$rc" "${MODEL:-default}" "$SAPI_VERSION" >"$BACKUP_PATH.run")
        log "run: exit $rc · backup $BACKUP_PATH · see 'sapi diff' for changes"
    else
        log "run: exit $rc"
    fi
    return "$rc"
}

# ---------------------------------------------------------------------------
# sapi diff [BACKUP] [--full]: what changed since the backup
# ---------------------------------------------------------------------------
latest_backup() {
    local root; root="$(backup_root)"
    [[ -d "$root" ]] || return 1
    find "$root" -maxdepth 1 -name '*.tar.gz' -type f | sort | tail -n 1
}

cmd_diff() {
    local file="" full=0 arg
    for arg in "$@"; do
        case "$arg" in
            --full) full=1 ;;
            -*) die "diff: unknown option $arg" ;;
            *) file="$arg" ;;
        esac
    done
    resolve_settings
    if [[ -z "$file" ]]; then
        file="$(latest_backup)" || die "diff: no backups for $WORKSPACE (take one with 'sapi backup' or run with --safer)"
    fi
    [[ -f "$file" ]] || die "diff: no such backup: $file"
    if [[ -f "$file.sha256" ]]; then
        [[ "$(awk '{print $1}' "$file.sha256")" == "$(sha256 <"$file")" ]] || die "diff: checksum mismatch for $file"
    fi
    DIFF_TMP="$(umask 077 && mktemp -d "${TMPDIR:-/tmp}/sapi-diff.XXXXXX")"
    trap 'rm -rf -- "${DIFF_TMP:-}"' EXIT
    local tmp="$DIFF_TMP"
    mkdir -p "$tmp/before"
    tar -xzf "$file" -C "$tmp/before" --strip-components=1 || die "diff: cannot extract $file"

    local added=0 deleted=0 modified=0 out
    # diff -rq is portable (GNU and BSD). Exit 1 = differences, 2 = trouble.
    local rc=0
    out="$(cd "$tmp" && diff -rq before "$WORKSPACE" 2>&1)" || rc=$?
    (( rc <= 1 )) || die "diff: diff failed: $out"
    local line path
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        case "$line" in
            "Only in before"*)
                path="${line#Only in before}"; path="${path#/}"; path="${path/: //}"; path="${path#/}"
                printf 'D  %s\n' "$path"; deleted=$((deleted + 1)) ;;
            "Only in $WORKSPACE"*)
                path="${line#Only in "$WORKSPACE"}"; path="${path#/}"; path="${path/: //}"; path="${path#/}"
                printf 'A  %s\n' "$path"; added=$((added + 1)) ;;
            Files*differ)
                path="${line#Files before/}"; path="${path%% and *}"
                printf 'M  %s\n' "$path"; modified=$((modified + 1)) ;;
            *) printf '?  %s\n' "$line" ;;
        esac
    done <<<"$out"
    if (( full == 1 )); then
        printf '\n'
        (cd "$tmp" && diff -ruN before "$WORKSPACE" 2>/dev/null | sed -e "s#^--- before/#--- backup/#" -e "s#^+++ $WORKSPACE/#+++ now/#") || true
    fi
    log "diff: $added added, $modified modified, $deleted deleted · vs $(basename "$file")$( [[ -f "$file.run" ]] && printf ' · run exit %s' "$(awk -F' = ' '$1 == "exit_code" {print $2}' "$file.run")")"
    (( added + modified + deleted == 0 ))
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
while [[ "${1:-}" == --safer || "${1:-}" == --no-safer ]]; do
    [[ "$1" == --safer ]] && SAFER_FLAG=true || SAFER_FLAG=false
    shift
done
case "${1:-}" in
    ""|-*)
        case "${1:-}" in
            "") cmd_start ;;
            -h|--help) usage ;;
            -V|--version) printf '%s\n' "$SAPI_VERSION" ;;
            *) die "unknown option: $1 (see sapi help)" ;;
        esac ;;
    run)        shift; cmd_run "$@" ;;
    diff)       shift; cmd_diff "$@" ;;
    backup)     cmd_backup ;;
    backups)    cmd_backups ;;
    restore)    shift; cmd_restore "$@" ;;
    config)     shift; cmd_config "$@" ;;
    help)       usage ;;
    version)    printf '%s\n' "$SAPI_VERSION" ;;
    dockerfile) cmd_dockerfile ;;
    build)      cmd_build ;;
    ls)         cmd_ls ;;
    rm)         cmd_rm "${2:-}" ;;
    shell)      cmd_shell "${2:-}" ;;
    upgrade)    cmd_upgrade ;;
    *)          [[ $# -eq 1 ]] || die "expected at most one container name (see sapi help)"
                cmd_start "$1" ;;
esac
